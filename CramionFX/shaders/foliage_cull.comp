#version 450
#extension GL_GOOGLE_include_directive : require

// Vegetacion: recorte y nivel de detalle de cada instancia (FoliagePass).
// Un hilo por arbol: fuera del campo de vision o mas lejos que la distancia
// maxima no se dibuja; si no, va a la lista de su especie y su nivel (por
// distancia) y suma uno en su comando de dibujo indirecto. Las cercanas van
// tambien a la lista de sombras (aunque esten fuera de la vista: su sombra
// puede caer dentro).

#include "foliage_common.glsl"

layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 0) readonly buffer Instances {
    FoliageInstance instances[];
};
layout(std430, set = 0, binding = 1) writeonly buffer Visible {
    uint visible[];
};
struct DrawCommand {
    uint index_count;
    uint instance_count;
    uint first_index;
    int vertex_offset;
    uint first_instance;  // inicio de la lista en `visible`
};
layout(std430, set = 0, binding = 2) buffer Commands {
    DrawCommand commands[];  // especie * 4 + (0, 1, 2 niveles; 3 sombras)
};

layout(push_constant) uniform CullPush {
    mat4 view_projection;
    vec4 camera;   // xyz posicion (con el origen flotante ya restado), w distancia maxima
    vec4 lod;      // x nivel 1, y nivel 2, z sombras, w proyectan sombra (0/1)
    uvec4 counts;  // x total de instancias
    vec4 offset;   // xyz origen flotante (se resta a las instancias)
} push;

vec4 row(int i) {
    return vec4(push.view_projection[0][i], push.view_projection[1][i], push.view_projection[2][i],
                push.view_projection[3][i]);
}

bool insideFrustum(vec3 center, float radius) {
    // Los 4 planos laterales (pasan por la camara: ya descartan lo de detras).
    // Sin cerca/lejos: no dependen de la convencion de profundidad; la
    // distancia maxima hace de plano lejano.
    vec4 r0 = row(0), r1 = row(1), r3 = row(3);
    vec4 planes[4] = vec4[](r3 + r0, r3 - r0, r3 + r1, r3 - r1);
    for (int i = 0; i < 4; ++i) {
        vec4 p = planes[i];
        if (dot(p.xyz, center) + p.w < -radius * length(p.xyz)) return false;
    }
    return true;
}

void push_to(uint list, uint index) {
    uint slot = atomicAdd(commands[list].instance_count, 1u);
    visible[commands[list].first_instance + slot] = index;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= push.counts.x) return;
    FoliageInstance inst = instances[i];
    uint species = foliageSpecies(inst.packed);
    float scale = foliageScale(inst.packed);
    vec3 base = inst.position - push.offset.xyz;
    vec3 center = base + vec3(0.0, kFoliageCenterY[species] * scale, 0.0);
    float radius = kFoliageRadius[species] * scale;
    float distance_to_camera = length(center - push.camera.xyz);

    if (push.lod.w > 0.5 && distance_to_camera < push.lod.z) push_to(species * 4u + 3u, i);
    if (distance_to_camera - radius > push.camera.w) return;
    if (!insideFrustum(center, radius)) return;
    uint level = distance_to_camera < push.lod.x ? 0u : (distance_to_camera < push.lod.y ? 1u : 2u);
    push_to(species * 4u + level, i);
}
