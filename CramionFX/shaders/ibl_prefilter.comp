#version 450
#extension GL_GOOGLE_include_directive : require

// IBL especular: cada nivel de mip del cubo de entorno guarda el entorno
// convolucionado con el lobulo GGX de una rugosidad (nivel 0 = espejo, ultimo
// = rugosidad 1). Es la parte "prefiltered environment" del split-sum de
// Karis (Unreal Engine 4, SIGGRAPH 2013).
//
// Se lanza una vez por nivel: (tamano/8, tamano/8, 6 caras).

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D sky_lut;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2DArray env_level;
layout(set = 0, binding = 2) uniform sampler2D environment_hdr;

layout(push_constant) uniform PushConstants {
    vec4 light_radiance;  // rgb = radiancia de la luz direccional activa, a = rugosidad
    vec4 to_light;        // xyz = hacia la luz
    uint face_size;
    uint sample_count;
    float hdr;            // 1 = el entorno es el mapa HDR, no el cielo fisico
    float wet;            // fraccion del suelo cubierta de agua (0 = seco)
} push;

#include "ibl_common.glsl"

// Mapa de entorno HDR (EnvironmentMap), si la escena trae uno (push.hdr).
// Convencion equirectangular: u = atan(z, x) / 2pi + 0.5, v = acos(y) / pi.
vec2 environmentUv(vec3 d) {
    return vec2(atan(d.z, d.x) / (2.0 * kPi) + 0.5, acos(clamp(d.y, -1.0, 1.0)) / kPi);
}

// Radiancia del entorno en una direccion: el cielo fisico o el mapa HDR (al
// mip `lod`: con el HDR el prefiltrado usa los mips para no dejar ruido).
vec3 environmentRadiance(vec3 direction, vec3 ground, float lod) {
    if (push.hdr > 0.5) {
        vec3 photo = textureLod(environment_hdr, environmentUv(direction), lod).rgb;
        if (direction.y >= 0.0 || push.wet <= 0.0) {
            return photo;
        }
        // El suelo de la foto, mojado: refleja la parte de arriba de la foto.
        vec3 mirrored = textureLod(environment_hdr,
                                   environmentUv(vec3(direction.x, -direction.y, direction.z)),
                                   lod).rgb;
        return wetGround(direction, photo, mirrored, push.wet);
    }
    return environment(direction, ground, push.wet);
}

// Direccion del centro de un texel (uv en [-1, 1]) de una cara del cubo, con
// la convencion de Vulkan (+X, -X, +Y, -Y, +Z, -Z).
vec3 cubeDirection(uint face, vec2 uv) {
    switch (face) {
        case 0u: return normalize(vec3(1.0, -uv.y, -uv.x));
        case 1u: return normalize(vec3(-1.0, -uv.y, uv.x));
        case 2u: return normalize(vec3(uv.x, 1.0, uv.y));
        case 3u: return normalize(vec3(uv.x, -1.0, -uv.y));
        case 4u: return normalize(vec3(uv.x, -uv.y, 1.0));
        default: return normalize(vec3(-uv.x, -uv.y, -1.0));
    }
}

float radicalInverse(uint bits) {
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    return float(bits) * 2.3283064365386963e-10;
}

vec3 importanceSampleGgx(vec2 xi, vec3 n, float alpha) {
    float phi = 2.0 * kPi * xi.x;
    float cos_theta = sqrt((1.0 - xi.y) / (1.0 + (alpha * alpha - 1.0) * xi.y));
    float sin_theta = sqrt(1.0 - cos_theta * cos_theta);
    vec3 h = vec3(sin_theta * cos(phi), sin_theta * sin(phi), cos_theta);

    vec3 up = abs(n.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(up, n));
    vec3 bitangent = cross(n, tangent);
    return normalize(tangent * h.x + bitangent * h.y + n * h.z);
}

void main() {
    uvec3 id = gl_GlobalInvocationID;
    if (id.x >= push.face_size || id.y >= push.face_size) {
        return;
    }

    vec2 uv = (vec2(id.xy) + 0.5) / float(push.face_size) * 2.0 - 1.0;
    vec3 n = cubeDirection(id.z, uv);
    vec3 ground = groundRadiance(push.light_radiance.rgb, push.to_light.xyz);

    float roughness = push.light_radiance.a;
    // Mip del HDR con el tamano de un texel de este nivel del cubo (la
    // equirectangular tiene ~4 caras de ancho).
    float base_lod = log2(max(float(textureSize(environment_hdr, 0).x) /
                                  (4.0 * float(push.face_size)), 1.0));
    vec3 color;
    if (roughness <= 0.0) {
        color = environmentRadiance(n, ground, base_lod);
    } else {
        // V = N = R: la aproximacion habitual del split-sum.
        float alpha = roughness * roughness;
        vec3 sum = vec3(0.0);
        float weight = 0.0;
        for (uint i = 0u; i < push.sample_count; ++i) {
            vec2 xi = vec2(float(i) / float(push.sample_count), radicalInverse(i));
            vec3 h = importanceSampleGgx(xi, n, alpha);
            vec3 l = normalize(2.0 * dot(n, h) * h - n);
            float n_dot_l = dot(n, l);
            if (n_dot_l > 0.0) {
                sum += environmentRadiance(l, ground, base_lod + 1.0 + roughness * 4.0) * n_dot_l;
                weight += n_dot_l;
            }
        }
        color = sum / max(weight, 0.0001);
    }

    imageStore(env_level, ivec3(id), vec4(color, 1.0));
}
