#version 450

// Filtro espacial de los reflejos por rayos (despues de
// rt_reflection_temporal.comp): transformada "a trous" con bordes guiada por
// la varianza (como la GI, gi_atrous.comp), con nucleo 5x5 separado por
// `step` pixeles (1 y 2: cubre 9x9 con 50 lecturas).
//
// La diferencia con la GI es el tamano: un reflejo solo debe emborronarse lo
// que emborrona su rugosidad. Cada muestra pesa ademas una gaussiana en
// pantalla de radio proporcional a la rugosidad del pixel: en un espejo el
// filtro no hace nada; en una superficie satinada junta los vecinos y se lleva
// el grano que el tiempo no quito (zonas recien destapadas, objetos que se
// mueven). Solo se mezclan pixeles de la misma superficie (profundidad,
// normal y rugosidad parecidas) y luminancias dentro del ruido esperado.
//
// Entrada y salida: rgb = reflejo, a = varianza de lo acumulado (el ruido que
// le queda). En la ultima pasada (`last`) el alfa pasa a ser la confianza que
// lee la iluminacion (la de rt_reflections.comp, que solo depende de la
// rugosidad).

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform CameraBuffer {
    mat4 view;
    mat4 projection;
    mat4 view_projection;
    mat4 inverse_view_projection;
    vec4 position;
} camera;

layout(set = 0, binding = 1) uniform sampler2D g_depth;
layout(set = 0, binding = 2) uniform sampler2D g_normal;  // b = rugosidad
layout(set = 0, binding = 3) uniform sampler2D in_color;  // rgb, a = varianza
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D out_color;

layout(push_constant) uniform PushConstants {
    int step;
    int last;  // 1 = ultima pasada: a = confianza
    int pad0;
    int pad1;
} push;

const float kMaxRoughness = 0.65;  // igual que rt_reflections.comp
const float kSigmaLuminance = 4.0;

float luminance(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

float linearDepth(float depth) {
    return (camera.projection[3][2] - depth * camera.projection[3][3]) / (camera.projection[2][2] - depth * camera.projection[2][3]);
}

vec3 decodeNormal(vec2 e) {
    vec3 n = vec3(e.x, 1.0 - abs(e.x) - abs(e.y), e.y);
    float t = max(-n.y, 0.0);
    n.x += n.x >= 0.0 ? -t : t;
    n.z += n.z >= 0.0 ? -t : t;
    return normalize(n);
}

float confidence(float roughness) {
    return roughness > kMaxRoughness ? 0.0 : 1.0 - smoothstep(kMaxRoughness * 0.75, kMaxRoughness, roughness);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(out_color);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }

    float raw_depth = texelFetch(g_depth, pixel, 0).r;
    vec4 center = texelFetch(in_color, pixel, 0);
    vec4 normal_sample = texelFetch(g_normal, pixel, 0);
    float roughness = normal_sample.b;
    float center_alpha = push.last != 0 ? (raw_depth >= 1.0 ? 0.0 : confidence(roughness)) : center.a;
    // Cielo, espejos (nada que filtrar) o demasiado rugoso (lo pone el IBL).
    if (raw_depth >= 1.0 || roughness < 0.04 || roughness > kMaxRoughness) {
        imageStore(out_color, pixel, vec4(center.rgb, center_alpha));
        return;
    }

    float center_luminance = luminance(center.rgb);
    // Ya convergido (el ruido que queda es menor que un 2 % del brillo): no
    // hay nada que quitar y no se lee ningun vecino. En una escena quieta es
    // casi toda la imagen.
    float deviation = sqrt(max(center.a, 0.0));
    if (deviation < 0.02 * (center_luminance + 0.02)) {
        imageStore(out_color, pixel, vec4(center.rgb, push.last != 0 ? center_alpha : center.a));
        return;
    }
    // Radio en pantalla que corresponde a la rugosidad (pixeles). Si ni el
    // vecino mas cercano de esta pasada pesa, tampoco hay nada que hacer.
    float radius = max(roughness * 18.0, 0.35);
    float inverse_two_radius2 = 1.0 / (2.0 * radius * radius);
    if (exp(-float(push.step * push.step) * inverse_two_radius2) < 0.01) {
        imageStore(out_color, pixel, vec4(center.rgb, push.last != 0 ? center_alpha : center.a));
        return;
    }

    float center_depth = linearDepth(raw_depth);
    vec3 center_normal = decodeNormal(normal_sample.rg);

    // Pendiente de la profundidad (un suelo en rasante cambia mucho de un
    // pixel al siguiente sin ser un borde).
    float depth_gradient = 1e-3;
    for (int i = 0; i < 4; ++i) {
        ivec2 offset = ivec2(i == 0 ? 1 : (i == 1 ? -1 : 0), i == 2 ? 1 : (i == 3 ? -1 : 0));
        ivec2 q = clamp(pixel + offset, ivec2(0), size - 1);
        float raw = texelFetch(g_depth, q, 0).r;
        if (raw < 1.0) {
            float difference = abs(linearDepth(raw) - center_depth);
            if (difference < 0.2 * center_depth) depth_gradient = max(depth_gradient, difference);
        }
    }

    // Peso de luminancia con la varianza de este pixel (ya acumulada en el
    // tiempo: suave de un pixel al siguiente).
    float luminance_scale = kSigmaLuminance * deviation + 1e-3;

    const float kKernel[3] = float[](3.0 / 8.0, 1.0 / 4.0, 1.0 / 16.0);
    vec3 color_sum = center.rgb;
    float weight_sum = 1.0;
    float variance_sum = center.a;
    for (int y = -2; y <= 2; ++y) {
        for (int x = -2; x <= 2; ++x) {
            if (x == 0 && y == 0) continue;
            ivec2 offset = ivec2(x, y) * push.step;
            ivec2 q = pixel + offset;
            if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, size))) continue;
            float distance2 = float(offset.x * offset.x + offset.y * offset.y);
            float spatial = exp(-distance2 * inverse_two_radius2);
            if (spatial < 0.01) continue;
            float raw = texelFetch(g_depth, q, 0).r;
            if (raw >= 1.0) continue;
            vec4 sample_normal = texelFetch(g_normal, q, 0);
            vec4 sample_color = texelFetch(in_color, q, 0);

            float kernel = kKernel[abs(x)] * kKernel[abs(y)] / (kKernel[0] * kKernel[0]);
            float w_depth = exp(-abs(center_depth - linearDepth(raw)) /
                                (depth_gradient * length(vec2(x, y)) * float(push.step) + 1e-3));
            float w_normal = pow(max(dot(center_normal, decodeNormal(sample_normal.rg)), 0.0), 64.0);
            float w_roughness = exp(-abs(sample_normal.b - roughness) * 16.0);
            float w_luminance = exp(-abs(center_luminance - luminance(sample_color.rgb)) / luminance_scale);
            float w = kernel * spatial * w_depth * w_normal * w_roughness * w_luminance;

            color_sum += sample_color.rgb * w;
            weight_sum += w;
            variance_sum += sample_color.a * w * w;
        }
    }

    vec3 color = color_sum / weight_sum;
    float alpha = push.last != 0 ? center_alpha : variance_sum / (weight_sum * weight_sum);
    imageStore(out_color, pixel, vec4(color, alpha));
}
