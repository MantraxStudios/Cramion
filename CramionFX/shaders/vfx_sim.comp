#version 450
#extension GL_GOOGLE_include_directive : require

// VFX Graph: simulacion de las particulas de un efecto (VfxPass). Un solo
// shader con etapas (push.stage) que interpreta los bloques compilados en la
// CPU (vfx/VisualEffect.cpp):
//
//   RESET    todas muertas en la pila del efecto
//   BEGIN    vivas del dibujo a 0 (un hilo por efecto)
//   EMIT     un hilo por particula nueva: sale de la pila, bloques Initialize
//   EMIT_EVENTS  un hilo por evento recibido (lo apunto otro efecto el frame
//            anterior al morir o chocar una de sus particulas): nacen en su
//            posicion y con su velocidad
//   UPDATE   un hilo por particula del rango: bloques Update (fuerzas),
//            integracion, colisiones; muere (vuelve a la pila) o pasa a la
//            lista de vivas del dibujo indirecto; los bloques Trigger apuntan
//            eventos en la lista de otro efecto; los Emit*, en un canal
//   EMIT_CHANNEL  dispatch indirecto, un hilo por evento del canal que
//            escucha (del frame anterior; de otros efectos o de scripts)

layout(local_size_x = 64) in;

#define VFX_COMPUTE
#include "vfx_common.glsl"

// ---------------------------------------------------------------------------
// Ruido (valor 3D suavizado) y ruido de rotacional (curl noise): un campo sin
// divergencia, remolinos que no se juntan en puntos.
// ---------------------------------------------------------------------------

float hash3(ivec3 c) {
    uvec3 q = uvec3(c + ivec3(32768));
    return float(vfxHash(q.x + vfxHash(q.y + vfxHash(q.z)))) * (2.0 / 4294967295.0) - 1.0;
}

float valueNoise(vec3 p) {
    vec3 i = floor(p);
    vec3 f = p - i;
    vec3 u = f * f * (3.0 - 2.0 * f);
    ivec3 c = ivec3(i);
    float n000 = hash3(c);
    float n100 = hash3(c + ivec3(1, 0, 0));
    float n010 = hash3(c + ivec3(0, 1, 0));
    float n110 = hash3(c + ivec3(1, 1, 0));
    float n001 = hash3(c + ivec3(0, 0, 1));
    float n101 = hash3(c + ivec3(1, 0, 1));
    float n011 = hash3(c + ivec3(0, 1, 1));
    float n111 = hash3(c + ivec3(1, 1, 1));
    float x00 = mix(n000, n100, u.x);
    float x10 = mix(n010, n110, u.x);
    float x01 = mix(n001, n101, u.x);
    float x11 = mix(n011, n111, u.x);
    return mix(mix(x00, x10, u.y), mix(x01, x11, u.y), u.z);
}

vec3 potential(vec3 p, int octaves) {
    vec3 sum = vec3(0.0);
    float amplitude = 1.0;
    float frequency = 1.0;
    for (int o = 0; o < octaves; ++o) {
        vec3 q = p * frequency;
        sum += amplitude * vec3(valueNoise(q), valueNoise(q + vec3(31.416, 47.853, 12.679)),
                                valueNoise(q + vec3(-19.123, 7.271, 83.117)));
        amplitude *= 0.5;
        frequency *= 2.0;
    }
    return sum;
}

vec3 curlNoise(vec3 p, int octaves) {
    const float e = 0.1;
    vec3 dx = potential(p + vec3(e, 0.0, 0.0), octaves) - potential(p - vec3(e, 0.0, 0.0), octaves);
    vec3 dy = potential(p + vec3(0.0, e, 0.0), octaves) - potential(p - vec3(0.0, e, 0.0), octaves);
    vec3 dz = potential(p + vec3(0.0, 0.0, e), octaves) - potential(p - vec3(0.0, 0.0, e), octaves);
    // curl = (dPz/dy - dPy/dz, dPx/dz - dPz/dx, dPy/dx - dPx/dy)
    return vec3(dy.z - dz.y, dz.x - dx.z, dx.y - dy.x) / (2.0 * e);
}

// Ruido rizado horneado (VfxPass: bakeVfxCurlVolume): 32^3 que se repite, el
// texel i es el campo en q = i / 4 (8 celdas de ruido por vuelta). Una
// lectura trilineal por octava en q * 2^o (el peso 0.5^o y la frecuencia 2^o
// se cancelan en el rotacional): 8 lecturas contra ~150 hashes del calculado.
layout(std430, set = 0, binding = 24) readonly buffer CurlVolume { vec4 curl_volume[]; };

// Salida Luz (luces de particula; ver emitParticleLight). MISMOS numeros que
// VfxPass::kMaxLightCandidates / kMaxInstances y kParticleLightBinding.
const uint VFX_MAX_LIGHT_CANDIDATES = 1024u;
layout(std430, set = 0, binding = 26) buffer VfxLightOut {
    uvec4 light_header;
    vec4 light_params[256];
    uvec4 light_items[];
};

vec3 curlFetch(ivec3 c) {
    c &= ivec3(31);
    return curl_volume[(c.z * 32 + c.y) * 32 + c.x].xyz;
}

vec3 curlSample(vec3 q) {
    vec3 t = q * 4.0;
    vec3 i = floor(t);
    vec3 f = t - i;
    ivec3 c = ivec3(i);
    vec3 x00 = mix(curlFetch(c), curlFetch(c + ivec3(1, 0, 0)), f.x);
    vec3 x10 = mix(curlFetch(c + ivec3(0, 1, 0)), curlFetch(c + ivec3(1, 1, 0)), f.x);
    vec3 x01 = mix(curlFetch(c + ivec3(0, 0, 1)), curlFetch(c + ivec3(1, 0, 1)), f.x);
    vec3 x11 = mix(curlFetch(c + ivec3(0, 1, 1)), curlFetch(c + ivec3(1, 1, 1)), f.x);
    return mix(mix(x00, x10, f.y), mix(x01, x11, f.y), f.z);
}

vec3 curlBaked(vec3 p, int octaves) {
    vec3 sum = vec3(0.0);
    float frequency = 1.0;
    for (int o = 0; o < octaves; ++o) {
        sum += curlSample(p * frequency);
        frequency *= 2.0;
    }
    return sum;
}

// ---------------------------------------------------------------------------
// Espacios: los bloques dan posiciones en el espacio del EMISOR (como el
// "Local" de Unity) y la gravedad/viento en el del MUNDO. La simulacion va
// en el mundo o en el emisor (world_space).
// ---------------------------------------------------------------------------

bool worldSpace(uint slot) {
    return (instances[slot].flags.z & VFX_WORLD_SPACE) != 0u;
}

// Punto del emisor -> espacio de la simulacion.
vec3 pointToSim(uint slot, vec3 p) {
    return worldSpace(slot) ? (instances[slot].local_to_world * vec4(p, 1.0)).xyz : p;
}

vec3 dirToSim(uint slot, vec3 d) {
    return worldSpace(slot) ? mat3(instances[slot].local_to_world) * d : d;
}

// Vector del mundo (gravedad, viento) -> espacio de la simulacion.
vec3 worldDirToSim(uint slot, vec3 d) {
    return worldSpace(slot) ? d : mat3(instances[slot].world_to_local) * d;
}

vec3 simToWorld(uint slot, vec3 p) {
    return (instances[slot].transform * vec4(p, 1.0)).xyz;
}

vec3 worldToSim(uint slot, vec3 p) {
    return worldSpace(slot) ? p : (instances[slot].world_to_local * vec4(p, 1.0)).xyz;
}

vec3 anyPerpendicular(vec3 n) {
    vec3 a = abs(n.y) < 0.99 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    return normalize(cross(a, n));
}

// ---------------------------------------------------------------------------
// RESET
// ---------------------------------------------------------------------------

void stageReset(uint slot) {
    uint i = gl_GlobalInvocationID.x;
    uint capacity = instances[slot].range.y;
    uint offset = instances[slot].range.x;
    if (i == 0u) {
        uint base = instances[slot].range.z * 8u;
        counters[base + 0u] = int(capacity);
        counters[base + 1u] = 0;
        counters[base + 2u] = 0;
        counters[base + 3u] = 0;
        counters[base + 4u] = 6;
        counters[base + 5u] = 0;
        counters[base + 6u] = 0;
        counters[base + 7u] = 0;
    }
    if (i >= capacity) return;
    uint p = offset + i;
    // La pila: la ultima en salir es la primera del rango.
    dead_list[offset + i] = offset + (capacity - 1u - i);
    particles[p * 4u + 0u] = vec4(0.0);
    particles[p * 4u + 1u] = vec4(0.0);
    particles[p * 4u + 2u] = vec4(0.0);
    particles[p * 4u + 3u] = vec4(0.0);
}

// ---------------------------------------------------------------------------
// BEGIN (un hilo por ranura: push.count = ranuras)
// ---------------------------------------------------------------------------

void stageBegin() {
    uint slot = gl_GlobalInvocationID.x;
    if (slot >= push.count) return;
    if (slot == 0u) light_header.x = 0u;  // Salida Luz: candidatas de este frame
    uint base = slot * 8u;
    counters[base + 1u] = 0;
    // Vertices por instancia del dibujo indirecto: 6 (un quad o un segmento
    // de cinta) o los indices de la malla.
    // Cinta suavizada: 6 por tramo (ribbon0.y tramos por segmento).
    int vertices = 6;
    if (instances[slot].extra.x == VFX_OUT_MESH) {
        vertices = int(instances[slot].extra.z);
    } else if (instances[slot].extra.x == VFX_OUT_RIBBON) {
        vertices = 6 * clamp(int(abs(instances[slot].ribbon0.y) + 0.5), 1, 16);
    }
    counters[base + 4u] = vertices;
    counters[base + 5u] = 0;
    counters[base + 6u] = 0;
    counters[base + 7u] = 0;
    // Los eventos de este frame empiezan de cero (los del anterior los lee
    // EMIT_EVENTS en el otro contador).
    counters[base + 2u + (push.pad & 1u)] = 0;
    // Canales de datos (solo si alguien escucha): los de este frame a cero,
    // el dispatch indirecto de los que escuchan con los del anterior (un
    // hilo por evento) y las nacidas por cada bloque de escucha a cero.
    if ((push.pad & VFX_PAD_CHANNELS) != 0u) {
        if (slot < VFX_MAX_CHANNELS) {
            uint cb = VFX_CHANNEL_COUNTERS + slot * 8u;
            uint write = push.pad & 1u;
            counters[cb + write] = 0;
            int pending = clamp(counters[cb + (write ^ 1u)], 0, int(VFX_MAX_CHANNEL_EVENTS));
            counters[cb + 4u] = (pending + 63) / 64;
            counters[cb + 5u] = 1;
            counters[cb + 6u] = 1;
        }
        for (uint k = 0u; k < VFX_MAX_LISTENS; ++k) counters[VFX_LISTEN_COUNTERS + slot * VFX_MAX_LISTENS + k] = 0;
    }
}

// ---------------------------------------------------------------------------
// EMIT
// ---------------------------------------------------------------------------

// Saca una particula de la pila del efecto. false: no queda ninguna
// (capacidad llena), no nace.
bool popDead(uint slot, out uint p) {
    uint base = instances[slot].range.z * 8u;
    int top = atomicAdd(counters[base + 0u], -1);
    if (top <= 0) {
        atomicAdd(counters[base + 0u], 1);
        p = 0u;
        return false;
    }
    p = dead_list[instances[slot].range.x + uint(top - 1)];
    return true;
}

// Una particula nueva en `p`: los bloques Initialize. Con evento, el emisor
// es un punto del mundo sin giro (la posicion del evento) y la velocidad que
// se hereda es la del evento (los que reciben eventos simulan en el mundo).
// event_value: el valor del evento (canales: E1.w; 0 en los demas), del que
// puede salir el id de la cinta (RibbonAttributes con id del evento).
void spawnParticle(uint slot, uint p, uint seed, bool from_event, vec3 event_position, vec3 event_velocity,
                   float event_value) {
    vec3 pos = vec3(0.0);
    vec3 vel = vec3(0.0);
    vec3 shape_dir = vec3(0.0, 1.0, 0.0);
    float lifetime = 1.0;
    float size = 0.1;
    vec4 color = vec4(1.0);
    float rotation = 0.0;
    float spin = 0.0;
    float frame0 = 0.0;
    bool positioned = false;
    // Cinta (RibbonAttributes): su id, su giro y el desplazamiento de su tira.
    uint ribbon_id = 0u;
    float ribbon_twist = 0.0;
    vec3 ribbon_offset = vec3(0.0);
    bool ribbon_attributes = false;

    uint first = instances[slot].blocks.x;
    uint count = instances[slot].blocks.y;
    for (uint b = first; b < first + count; ++b) {
        VfxBlock k = blocks[b];
        uint type = k.info.x;
        if (type == B_POSITION_SPHERE) {
            vec3 d = vfxRandomDirection(seed);
            float arc = clamp(k.b.y, 0.0, 360.0) * 0.0174532925;
            if (arc < 6.2831) {
                float phi = vfxRand(seed) * arc;
                float r = sqrt(max(1.0 - d.y * d.y, 0.0));
                d = vec3(r * cos(phi), d.y, r * sin(phi));
            }
            float volume = clamp(k.b.x, 0.0, 1.0);
            float r = k.a.w * (1.0 - volume * (1.0 - pow(vfxRand(seed), 1.0 / 3.0)));
            pos = k.a.xyz + d * r;
            shape_dir = d;
            positioned = true;
        } else if (type == B_POSITION_BOX) {
            vec3 size3 = max(k.b.xyz, vec3(0.0));
            vec3 u = vec3(vfxRand(seed), vfxRand(seed), vfxRand(seed)) - 0.5;
            if (k.b.w > 0.5) {
                // Superficie: una cara al azar segun su area.
                vec3 area = vec3(size3.y * size3.z, size3.x * size3.z, size3.x * size3.y);
                float total = max(area.x + area.y + area.z, 1e-6);
                float pick = vfxRand(seed) * total;
                float side = vfxRand(seed) < 0.5 ? -0.5 : 0.5;
                if (pick < area.x) {
                    u.x = side;
                    shape_dir = vec3(sign(side), 0.0, 0.0);
                } else if (pick < area.x + area.y) {
                    u.y = side;
                    shape_dir = vec3(0.0, sign(side), 0.0);
                } else {
                    u.z = side;
                    shape_dir = vec3(0.0, 0.0, sign(side));
                }
            } else {
                shape_dir = length(u) > 1e-4 ? normalize(u) : vec3(0.0, 1.0, 0.0);
            }
            pos = k.a.xyz + u * size3;
            positioned = true;
        } else if (type == B_POSITION_CONE) {
            float volume = clamp(k.b.z, 0.0, 1.0);
            float rr = 1.0 - volume * (1.0 - sqrt(vfxRand(seed)));  // 0..1 del radio
            float phi = vfxRand(seed) * 6.28318530718;
            float angle = clamp(k.b.x, 0.0, 89.0) * 0.0174532925;
            float tilt = angle * (k.a.w > 1e-5 ? rr : sqrt(vfxRand(seed)));
            vec3 dir = vec3(sin(tilt) * cos(phi), cos(tilt), sin(tilt) * sin(phi));
            vec3 base = vec3(cos(phi), 0.0, sin(phi)) * (k.a.w * rr);
            pos = k.a.xyz + base + dir * (max(k.b.y, 0.0) * vfxRand(seed));
            shape_dir = dir;
            positioned = true;
        } else if (type == B_POSITION_CIRCLE) {
            float volume = clamp(k.b.x, 0.0, 1.0);
            float rr = 1.0 - volume * (1.0 - sqrt(vfxRand(seed)));
            float phi = vfxRand(seed) * 6.28318530718;
            vec3 radial = vec3(cos(phi), 0.0, sin(phi));
            pos = k.a.xyz + radial * (k.a.w * rr);
            shape_dir = radial;
            positioned = true;
        } else if (type == B_POSITION_LINE) {
            pos = mix(k.a.xyz, k.b.xyz, vfxRand(seed));
            shape_dir = vec3(0.0, 1.0, 0.0);
            positioned = true;
        } else if (type == B_POSITION_MESH) {
            uint n = uint(max(k.a.y, 0.0));
            if (n > 0u) {
                uint idx = uint(k.a.x) + min(uint(vfxRand(seed) * float(n)), n - 1u);
                vec3 normal = points[idx * 2u + 1u].xyz;
                pos = points[idx * 2u].xyz + normal * k.b.x;
                shape_dir = length(normal) > 1e-4 ? normalize(normal) : vec3(0.0, 1.0, 0.0);
                positioned = true;
            }
        } else if (type == B_VELOCITY_RANDOM) {
            vec3 v = vec3(vfxRange(seed, k.a.x, k.b.x), vfxRange(seed, k.a.y, k.b.y), vfxRange(seed, k.a.z, k.b.z));
            vel = (k.info.y & 1u) != 0u ? vel + v : v;
        } else if (type == B_VELOCITY_FROM_SHAPE) {
            vec3 d = shape_dir;
            float spread = clamp(k.a.z, 0.0, 180.0) * 0.0174532925;
            if (spread > 1e-4) {
                vec3 t = anyPerpendicular(d);
                vec3 bt = cross(d, t);
                float a = vfxRand(seed) * spread;
                float phi = vfxRand(seed) * 6.28318530718;
                d = normalize(d * cos(a) + (t * cos(phi) + bt * sin(phi)) * sin(a));
            }
            vel += d * vfxRange(seed, k.a.x, k.a.y);
        } else if (type == B_LIFETIME) {
            lifetime = max(vfxRange(seed, k.a.x, k.a.y), 0.01);
        } else if (type == B_SIZE) {
            size = max(vfxRange(seed, k.a.x, k.a.y), 0.0);
        } else if (type == B_COLOR) {
            color = mix(k.a, k.b, vfxRand(seed));
        } else if (type == B_ROTATION) {
            rotation = vfxRange(seed, k.a.x, k.a.y) * 0.0174532925;
            spin = vfxRange(seed, k.a.z, k.a.w) * 0.0174532925;
        } else if (type == B_MESH_INDEX) {
            // Variante de la salida Malla (en el hueco del cuadro inicial: las
            // mallas no usan flipbook).
            frame0 = floor(vfxRange(seed, max(k.a.x, 0.0), max(k.a.y, k.a.x) + 0.999));
        } else if (type == B_FLIPBOOK_FRAME) {
            frame0 = floor(vfxRange(seed, k.a.x, k.a.y + 0.999));
            // Velocidad por particula (+-a.z) en la fraccion: velocidad - 0.5
            // (0 = sin variacion; los .crvfx de antes no tiran el dado).
            float variation = clamp(k.a.z, 0.0, 0.5);
            if (variation > 0.0) {
                float speed = 1.0 + variation * (vfxRand(seed) * 2.0 - 1.0);
                frame0 += clamp(speed - 0.5, 0.001, 0.999);
            }
        } else if (type == B_RIBBON_ATTRIBUTES) {
            // Tiras: el orden de nacimiento en este frame las reparte.
            uint strands = uint(clamp(k.a.y, 1.0, 256.0));
            uint strand = gl_GlobalInvocationID.x % strands;
            ribbon_id = min(uint(clamp(k.a.x, 0.0, 255.0)) + strand, 255u);
            // Id del evento (flags 1): una cinta por cada valor de evento (un
            // proyectil = un valor), cada una con sus tiras. 256 ids por efecto.
            if ((k.info.y & 1u) != 0u && from_event) {
                uint source = uint(max(event_value, 0.0) + 0.5);
                ribbon_id = (uint(clamp(k.a.x, 0.0, 255.0)) + source * strands + strand) & 255u;
            }
            if (k.a.z > 0.0) size = k.a.z;
            ribbon_twist = vfxRange(seed, k.a.w, k.b.x) * 0.0174532925;
            ribbon_offset = k.b.yzw * (float(strand) - float(strands - 1u) * 0.5);
            ribbon_attributes = true;
        }
    }
    // Tiras paralelas: cada una corrida su parte de la separacion.
    if (ribbon_attributes) {
        pos += ribbon_offset;
        positioned = positioned || dot(ribbon_offset, ribbon_offset) > 0.0;
    }

    // A la simulacion: las posiciones y direcciones del emisor (o del evento).
    vec3 sim_pos = from_event ? event_position + (positioned ? pos : vec3(0.0))
                              : pointToSim(slot, positioned ? pos : vec3(0.0));
    vec3 sim_vel = from_event ? vel : dirToSim(slot, vel);
    // Heredar la velocidad del emisor o del evento (despues de pasar al mundo).
    vec3 inherited = from_event ? event_velocity : worldDirToSim(slot, instances[slot].emitter_velocity.xyz);
    for (uint b = first; b < first + count; ++b) {
        if (blocks[b].info.x == B_INHERIT_VELOCITY) sim_vel += inherited * blocks[b].a.x;
    }
    // Nacen repartidas dentro del frame (sin "capas" con mucho caudal). Las de
    // los eventos, en el instante del evento.
    float dt = instances[slot].time.x;
    float early = from_event ? 0.0 : vfxRand(seed) * dt;
    sim_pos += sim_vel * early;
    // Y donde estaba el emisor en ese instante (cintas, caudal por distancia):
    // sin esto las de un frame salian todas del mismo punto y la estela de un
    // emisor rapido iba a escalones.
    bool interpolate = !from_event && worldSpace(slot) && (instances[slot].flags.z & VFX_INTERPOLATE) != 0u;
    if (interpolate) sim_pos -= instances[slot].emitter_velocity.xyz * early;
    // UPDATE quitara el desplazamiento del origen de este frame: estas ya
    // nacieron en las coordenadas nuevas (las de un evento no: su posicion es
    // de cuando se apunto, el frame anterior).
    if (worldSpace(slot) && !from_event) sim_pos += instances[slot].shift.xyz;

    // Cinta: en el giro, su id y el eje "de cara al emisor" (su Y en el mundo
    // al nacer) empaquetados; en la velocidad de giro, el giro de la cinta
    // (RibbonAttributes); y la U por longitud (los metros que llevaba el
    // emisor, en repeticiones de la textura).
    if (instances[slot].extra.x == VFX_OUT_RIBBON) {
        vec3 axis = mat3(instances[slot].local_to_world) * vec3(0.0, 1.0, 0.0);
        rotation = vfxRibbonPack(ribbon_id, length(axis) > 1e-6 ? normalize(axis) : vec3(0.0, 1.0, 0.0));
        spin = ribbon_twist;
        float travelled = instances[slot].output2.y -
                          (interpolate ? length(instances[slot].emitter_velocity.xyz) * early : 0.0);
        frame0 = travelled / max(instances[slot].output2.x, 1e-3);
    }

    particles[p * 4u + 0u] = vec4(sim_pos, early);
    particles[p * 4u + 1u] = vec4(sim_vel, lifetime);
    particles[p * 4u + 2u] = color;
    particles[p * 4u + 3u] = vec4(size, rotation, spin, frame0);
}

void stageEmit(uint slot) {
    uint i = gl_GlobalInvocationID.x;
    if (i >= instances[slot].range.w) return;
    uint p;
    if (!popDead(slot, p)) return;
    uint seed = vfxHash(instances[slot].flags.x ^ vfxHash(instances[slot].flags.y * 9781u + i * 6271u));
    spawnParticle(slot, p, seed, false, vec3(0.0), vec3(0.0), 0.0);
}

// ---------------------------------------------------------------------------
// EMIT_EVENTS (un hilo por evento, como mucho VFX_MAX_EVENTS)
// ---------------------------------------------------------------------------

void stageEmitEvents(uint slot) {
    uint e = gl_GlobalInvocationID.x;
    uint list = instances[slot].extra.w;
    if (list == VFX_NO_EVENTS || e >= VFX_MAX_EVENTS) return;
    // Los que se apuntaron el frame anterior (el otro contador).
    uint read = (push.pad & 1u) ^ 1u;
    uint base = instances[slot].range.z * 8u;
    uint received = uint(clamp(counters[base + 2u + read], 0, int(VFX_MAX_EVENTS)));
    if (e >= received) return;
    uint index = vfxEventIndex(list, read, e);
    vec4 E0 = events[index];
    vec4 E1 = events[index + 1u];
    uint n = uint(clamp(E0.w, 0.0, 64.0));
    for (uint k = 0u; k < n; ++k) {
        uint p;
        if (!popDead(slot, p)) return;
        uint seed = vfxHash(instances[slot].flags.x ^ vfxHash(instances[slot].flags.y * 7027u + e * 131u + k * 7919u + 17u));
        spawnParticle(slot, p, seed, true, E0.xyz, E1.xyz, E1.w);
    }
}

// ---------------------------------------------------------------------------
// EMIT_CHANNEL (dispatch indirecto: un hilo por evento del canal del frame
// anterior). push.count = el bloque de escucha (detras de los Update).
// ---------------------------------------------------------------------------

void stageEmitChannel(uint slot) {
    uint listen = push.count;
    if (listen >= VFX_MAX_LISTENS) return;
    VfxBlock L = blocks[instances[slot].blocks.z + instances[slot].blocks.w + listen];
    if (L.info.x != B_ON_GPU_EVENT) return;  // no cupo en el buffer de bloques
    uint channel = L.info.z;
    if (channel >= VFX_MAX_CHANNELS) return;
    uint read = (push.pad & 1u) ^ 1u;
    uint received = uint(clamp(counters[VFX_CHANNEL_COUNTERS + channel * 8u + read], 0, int(VFX_MAX_CHANNEL_EVENTS)));
    uint e = gl_GlobalInvocationID.x;
    if (e >= received) return;
    uint index = vfxChannelIndex(channel, read, e);
    vec4 E0 = events[index];
    vec4 E1 = events[index + 1u];
    vec4 E2 = events[index + 2u];
    if (L.a.x >= 0.0 && abs(E0.w - L.a.x) > 0.5) return;  // otro tipo
    int want = int(clamp(L.a.y, 0.0, 64.0));
    if (want <= 0) return;
    // Maximo por frame: cada evento reserva las suyas con un atomico.
    int n = want;
    if (L.a.z > 0.0) {
        int taken = atomicAdd(counters[VFX_LISTEN_COUNTERS + instances[slot].range.z * VFX_MAX_LISTENS + listen], want);
        n = clamp(int(L.a.z) - taken, 0, want);
    }
    for (int j = 0; j < n; ++j) {
        uint p;
        if (!popDead(slot, p)) return;
        uint seed = vfxHash(instances[slot].flags.x ^
                            vfxHash(instances[slot].flags.y * 4111u + e * 197u + uint(j) * 7919u + listen * 31u + 29u));
        spawnParticle(slot, p, seed, true, E0.xyz, E1.xyz, E1.w);
        // Velocidad heredada del evento, su color y su valor como tamano.
        particles[p * 4u + 1u].xyz += E1.xyz * L.a.w;
        if ((L.info.y & 1u) != 0u) particles[p * 4u + 2u] *= E2;
        if ((L.info.y & 2u) != 0u) particles[p * 4u + 3u].x *= max(E1.w, 0.0);
    }
}

// ---------------------------------------------------------------------------
// UPDATE
// ---------------------------------------------------------------------------

bool isCollision(uint type) {
    return type == B_COLLIDE_DEPTH || type == B_COLLIDE_PLANE || type == B_COLLIDE_SPHERE || type == B_KILL_BOX;
}

vec3 worldFromDepth(vec2 uv, float depth) {
    vec4 p = frame.inverse_view_projection * vec4(uv * 2.0 - 1.0, depth, 1.0);
    return p.xyz / p.w;
}

// Rebote contra una superficie (normal n, en el espacio de la simulacion).
// Devuelve la rapidez con que llego contra ella (0 si ya se alejaba).
float bounce(inout vec3 vel, vec3 n, float restitution, float friction) {
    float vn = dot(vel, n);
    if (vn < 0.0) {
        vec3 vt = vel - n * vn;
        vel = vt * (1.0 - clamp(friction, 0.0, 1.0)) - n * vn * clamp(restitution, 0.0, 1.0);
    }
    return max(-vn, 0.0);
}

// Apunta un evento de un bloque Trigger en la lista del efecto destino.
void emitEvent(uint slot, VfxBlock k, vec3 world_position, vec3 world_velocity, inout uint seed) {
    uint target = k.info.z;
    uint list = k.info.w;
    if (target == VFX_NO_EVENTS || list == VFX_NO_EVENTS) return;
    if (k.a.y < 1.0 && vfxRand(seed) >= k.a.y) return;  // probabilidad
    uint write = push.pad & 1u;
    int e = atomicAdd(counters[target * 8u + 2u + write], 1);
    if (e < 0 || e >= int(VFX_MAX_EVENTS)) return;  // lista llena este frame
    uint index = vfxEventIndex(list, write, uint(e));
    events[index] = vec4(world_position, max(k.a.x, 0.0));
    events[index + 1u] = vec4(world_velocity * k.a.w, 0.0);
}

// Apunta un evento de un bloque Emit* en su canal (con el tope por frame).
// flags 2: el valor es el id de la particula que lo apunta (estable en su
// vida): las cintas con "id del evento" hacen una cinta por particula.
void emitChannel(VfxBlock k, uint particle, vec3 world_position, vec3 world_velocity, vec4 particle_color, inout uint seed) {
    uint channel = k.info.z;
    if (channel >= VFX_MAX_CHANNELS) return;
    if (k.b.z < 1.0 && vfxRand(seed) >= k.b.z) return;  // probabilidad
    uint write = push.pad & 1u;
    int e = atomicAdd(counters[VFX_CHANNEL_COUNTERS + channel * 8u + write], 1);
    if (e < 0 || e >= int(VFX_MAX_CHANNEL_EVENTS)) return;  // canal lleno este frame
    uint index = vfxChannelIndex(channel, write, uint(e));
    events[index] = vec4(world_position, k.b.x);
    events[index + 1u] = vec4(world_velocity, (k.info.y & 2u) != 0u ? float(particle) : k.b.y);
    events[index + 2u] = (k.info.y & 1u) != 0u ? k.a * particle_color : k.a;
}

// ---------------------------------------------------------------------------
// Salida Luz (luces de particula): las vivas de un efecto con luz apuntan
// aqui su luz; la CPU las lee cuando vuelve este hueco de frame
// (VfxPass::gatherLights), elige las que caben y van a las luces por
// clusteres. Un buffer por hueco (kParticleLightBinding en VfxPass.cpp):
//   cabecera   x = candidatas apuntadas (BEGIN la pone a 0)
//   por ranura x alcance (m), y intensidad (0 = el efecto no da luz),
//              w parte estable de las vivas que apuntan (0..1)
//   candidatas 3 uvec4 (bits de float): (posicion en el mundo, alcance)
//              (color por la intensidad, clave = ranura << 21 | particula)
//              (velocidad en el mundo, -)
// (VfxLightOut va declarado arriba, junto al ruido horneado.)
// ---------------------------------------------------------------------------

void emitParticleLight(uint slot, uint i, uint p, vec3 pos, vec3 vel, float age, float lifetime, vec4 color) {
    vec4 params = light_params[slot];
    if (params.y <= 0.0) return;  // sin luz (casi todos los efectos)
    // Siempre las mismas de entre las vivas (la clave es la particula): con
    // muchas vivas, solo una parte apunta y no salta de una a otra.
    if (params.w < 1.0 && float(vfxHash(p * 2654435761u + 977u)) * (1.0 / 4294967296.0) >= params.w) return;
    // El color de la particula con Color en la vida; el alfa la apaga.
    if ((instances[slot].flags.z & VFX_COLOR_OVER_LIFE) != 0u) color *= vfxColorLut(slot, age / max(lifetime, 1e-5));
    vec3 rgb = max(color.rgb, vec3(0.0)) * clamp(color.a, 0.0, 1.0) * params.y;
    if (max(rgb.r, max(rgb.g, rgb.b)) < 1e-3) return;
    uint n = atomicAdd(light_header.x, 1u);
    if (n >= VFX_MAX_LIGHT_CANDIDATES) return;
    vec3 world = simToWorld(slot, pos);
    vec3 world_velocity = mat3(instances[slot].transform) * vel;
    light_items[n * 3u + 0u] = uvec4(floatBitsToUint(world), floatBitsToUint(params.x));
    light_items[n * 3u + 1u] = uvec4(floatBitsToUint(rgb), (slot << 21u) | (i & 0x1FFFFFu));
    light_items[n * 3u + 2u] = uvec4(floatBitsToUint(world_velocity), 0u);
}

void stageUpdate(uint slot) {
    uint i = gl_GlobalInvocationID.x;
    if (i >= instances[slot].range.y) return;
    uint offset = instances[slot].range.x;
    uint p = offset + i;
    vec4 P0 = particles[p * 4u + 0u];
    vec4 P1 = particles[p * 4u + 1u];
    if (P1.w <= 0.0) return;  // muerta (esta en la pila)
    vec4 P2 = particles[p * 4u + 2u];
    vec4 P3 = particles[p * 4u + 3u];

    vec3 pos = P0.xyz;
    vec3 vel = P1.xyz;
    float age = P0.w;
    float lifetime = P1.w;
    float dt = instances[slot].time.x;
    float clock = instances[slot].time.y;
    uint base = instances[slot].range.z * 8u;
    if (worldSpace(slot)) pos -= instances[slot].shift.xyz;

    uint seed = vfxHash(p * 7919u ^ vfxHash(instances[slot].flags.y));
    float radius = P3.x * 0.5;
    bool dies = false;
    // Choques de este frame (bloques Trigger al chocar): la rapidez mayor.
    bool collided = false;
    float impact = 0.0;

    uint first = instances[slot].blocks.z;
    uint count = instances[slot].blocks.w;
    if (dt > 0.0) {
        // --- Fuerzas, en orden ---
        for (uint b = first; b < first + count; ++b) {
            VfxBlock k = blocks[b];
            uint type = k.info.x;
            if (type == B_GRAVITY) {
                vel += worldDirToSim(slot, k.a.xyz) * dt;
            } else if (type == B_WIND) {
                vec3 wind = worldDirToSim(slot, k.a.xyz);
                vel += (wind - vel) * clamp(k.a.w * dt, 0.0, 1.0);
            } else if (type == B_DRAG) {
                float speed = length(vel);
                float damping = max(k.a.x, 0.0) + max(k.a.y, 0.0) * speed;
                vel *= 1.0 / (1.0 + damping * dt);
            } else if (type == B_TURBULENCE) {
                // En el mundo: el patron no se mueve con el emisor.
                vec3 world = simToWorld(slot, pos);
                vec3 q = world * max(k.a.y, 1e-4) + vec3(0.0, clock * k.a.w, clock * k.a.w * 0.37);
                int octaves = clamp(int(k.a.z + 0.5), 1, 4);
                // Horneado si el pase tiene el volumen; si no, calculado.
                bool baked = (instances[slot].flags.z & VFX_CURL_BAKED) != 0u;
                vec3 force = (baked ? curlBaked(q, octaves) : curlNoise(q, octaves)) * k.a.x;
                vel += worldDirToSim(slot, force) * dt;
            } else if (type == B_ATTRACTOR) {
                vec3 target = pointToSim(slot, k.a.xyz);
                vec3 d = target - pos;
                float dist = length(d);
                if (k.b.y > 0.0 && dist < k.b.y) {
                    dies = true;
                } else if (dist > 1e-4 && (k.b.x <= 0.0 || dist < k.b.x)) {
                    float falloff = k.b.x > 0.0 ? 1.0 - dist / k.b.x : 1.0;
                    vel += d / dist * (k.a.w * falloff * dt);
                }
            } else if (type == B_VORTEX) {
                vec3 center = pointToSim(slot, k.a.xyz);
                vec3 axis = normalize(dirToSim(slot, length(k.b.xyz) > 1e-4 ? k.b.xyz : vec3(0.0, 1.0, 0.0)));
                vec3 rel = pos - center;
                vec3 radial = rel - axis * dot(rel, axis);
                float r = length(radial);
                if (r > 1e-4) {
                    vec3 tangent = normalize(cross(axis, radial));
                    vel += tangent * (k.a.w * dt) - radial / r * (k.b.w * dt);
                }
            } else if (type == B_SPEED_LIMIT) {
                float speed = length(vel);
                float limit = max(k.a.x, 0.0);
                if (speed > limit && speed > 1e-5) {
                    float target = mix(speed, limit, clamp(k.a.y > 0.0 ? k.a.y : 1.0, 0.0, 1.0));
                    vel *= target / speed;
                }
            } else if (type == B_CONFORM_SPHERE) {
                vec3 center = pointToSim(slot, k.a.xyz);
                vec3 rel = pos - center;
                float dist = length(rel);
                if (dist > 1e-4) {
                    vec3 n = rel / dist;
                    float error = k.a.w - dist;  // > 0 dentro
                    vel += n * (error * max(k.b.x, 0.0) * dt);
                    // Pegajosidad: frena lo que va hacia fuera/dentro de la esfera.
                    vel -= n * dot(vel, n) * clamp(k.b.y * dt, 0.0, 1.0);
                }
            } else if (type == B_ANGULAR_VELOCITY && instances[slot].extra.x != VFX_OUT_RIBBON) {
                // Velocidad de giro (P3.z, rad/s): aceleracion, rozamiento y,
                // con a.z, rodar (giro = rapidez x rad por metro).
                P3.z += k.a.x * dt;
                P3.z *= 1.0 / (1.0 + max(k.a.y, 0.0) * dt);
                if (k.a.z != 0.0) P3.z = length(vel) * k.a.z;
            }
        }

        // --- Integracion ---
        pos += vel * dt;
        age += dt;
        // (En las cintas giro y velocidad de giro guardan su eje.)
        if (instances[slot].extra.x != VFX_OUT_RIBBON) P3.y += P3.z * dt;

        // --- Colisiones y zonas, en orden ---
        for (uint b = first; b < first + count; ++b) {
            VfxBlock k = blocks[b];
            uint type = k.info.x;
            if (!isCollision(type)) continue;
            if (type == B_COLLIDE_PLANE) {
                // flags 1: el plano en el mundo (no se mueve ni gira con el
                // emisor); "Sobre el terreno" lo deja asi con la altura del
                // suelo bajo el emisor (VfxSystem). Sin depender de la vista.
                bool plane_world = (k.info.y & 1u) != 0u;
                vec3 normal = length(k.a.xyz) > 1e-4 ? normalize(k.a.xyz) : vec3(0.0, 1.0, 0.0);
                vec3 n = normalize(plane_world ? worldDirToSim(slot, normal) : dirToSim(slot, normal));
                vec3 on = plane_world ? worldToSim(slot, normal * k.a.w) : pointToSim(slot, normal * k.a.w);
                float d = dot(pos - on, n) - radius;
                if (d < 0.0) {
                    pos -= n * d;
                    impact = max(impact, bounce(vel, n, k.b.x, k.b.y));
                    collided = true;
                    age += clamp(k.b.z, 0.0, 1.0) * lifetime;
                }
            } else if (type == B_COLLIDE_SPHERE) {
                vec3 center = pointToSim(slot, k.a.xyz);
                vec3 rel = pos - center;
                float dist = length(rel);
                bool inside = k.b.z > 0.5;  // las particulas viven DENTRO de la esfera
                if (dist > 1e-5) {
                    vec3 n = rel / dist;
                    if (!inside && dist < k.a.w + radius) {
                        pos = center + n * (k.a.w + radius);
                        impact = max(impact, bounce(vel, n, k.b.x, k.b.y));
                        collided = true;
                    } else if (inside && dist > k.a.w - radius) {
                        pos = center + n * max(k.a.w - radius, 0.0);
                        impact = max(impact, bounce(vel, -n, k.b.x, k.b.y));
                        collided = true;
                    }
                }
            } else if (type == B_KILL_BOX) {
                // En el espacio del emisor (gira y se mueve con el); flags 2:
                // caja fija en el mundo (alineada con los ejes).
                vec3 world_point = simToWorld(slot, pos);
                vec3 local = ((k.info.y & 2u) != 0u ? world_point
                                                    : (instances[slot].world_to_local * vec4(world_point, 1.0)).xyz) - k.a.xyz;
                bool in_box = all(lessThanEqual(abs(local), max(k.b.xyz, vec3(0.0)) * 0.5));
                bool kill_outside = (k.info.y & 1u) != 0u;
                if (in_box != kill_outside) dies = true;
            } else if (type == B_COLLIDE_DEPTH) {
                vec3 world = simToWorld(slot, pos);
                float r = radius * max(k.a.w, 0.0);
                // Suelo sin la vista (c.y > 0.5: "Suelo fuera de la vista",
                // c.x la altura del terreno bajo el emisor, la pone VfxSystem):
                // lo que cae fuera de la pantalla o detras de algo tambien
                // choca (y apunta sus eventos).
                if (k.c.y > 0.5 && world.y < k.c.x + r) {
                    vec3 n_sim = worldDirToSim(slot, vec3(0.0, 1.0, 0.0));
                    float n_len = length(n_sim);
                    n_sim = n_len > 1e-6 ? n_sim / n_len : n_sim;
                    pos = worldToSim(slot, vec3(world.x, k.c.x + r, world.z));
                    impact = max(impact, bounce(vel, n_sim, k.a.x, k.a.y));
                    collided = true;
                    age += clamp(k.a.z, 0.0, 1.0) * lifetime;
                    if (k.b.y > 0.5) dies = true;
                    continue;
                }
                if (frame.camera.w <= 0.5) continue;
                // Contra lo que ve la camara (el depth de la escena).
                vec4 clip = frame.view_projection * vec4(world, 1.0);
                if (clip.w <= 1e-4) continue;
                vec3 ndc = clip.xyz / clip.w;
                vec2 uv = ndc.xy * 0.5 + 0.5;
                if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) continue;
                float depth = textureLod(scene_depth, uv, 0.0).r;
                if (depth >= 1.0) continue;  // cielo
                vec3 surface = worldFromDepth(uv, depth);
                vec3 cam = frame.camera.xyz;
                float d_particle = length(world - cam);
                float d_surface = length(surface - cam);
                float thickness = max(k.b.x, 0.05);
                if (d_particle > d_surface - r && d_particle < d_surface + thickness) {
                    vec2 texel = frame.viewport.zw;
                    vec2 uvx = uv + vec2(texel.x, 0.0);
                    vec2 uvy = uv + vec2(0.0, texel.y);
                    vec3 px = worldFromDepth(uvx, textureLod(scene_depth, uvx, 0.0).r);
                    vec3 py = worldFromDepth(uvy, textureLod(scene_depth, uvy, 0.0).r);
                    vec3 n = cross(px - surface, py - surface);
                    if (length(n) < 1e-8) continue;
                    n = normalize(n);
                    if (dot(n, cam - surface) < 0.0) n = -n;
                    // De vuelta a la superficie (mas el radio), en el mundo.
                    vec3 fixed_world = surface + n * r;
                    vec3 n_sim = worldDirToSim(slot, n);
                    float n_len = length(n_sim);
                    n_sim = n_len > 1e-6 ? n_sim / n_len : n_sim;
                    pos = worldToSim(slot, fixed_world);
                    impact = max(impact, bounce(vel, n_sim, k.a.x, k.a.y));
                    collided = true;
                    age += clamp(k.a.z, 0.0, 1.0) * lifetime;
                    if (k.b.y > 0.5) dies = true;
                }
            }
        }
    }

    // --- Eventos (Trigger): al morir y al chocar, a la lista de otro efecto ---
    bool dying = dies || age >= lifetime;
    if (dt > 0.0 && (dying || collided)) {
        vec3 world_position = simToWorld(slot, pos);
        vec3 world_velocity = mat3(instances[slot].transform) * vel;
        for (uint b = first; b < first + count; ++b) {
            uint type = blocks[b].info.x;
            if (type == B_TRIGGER_DIE && dying) {
                emitEvent(slot, blocks[b], world_position, world_velocity, seed);
            } else if (type == B_TRIGGER_COLLIDE && collided && impact >= blocks[b].a.z) {
                emitEvent(slot, blocks[b], world_position, world_velocity, seed);
            }
        }
    }

    // --- Canales de datos (Emit*): al morir, al chocar y cada t segundos ---
    // Solo los efectos con bloques Emit* y si alguien escucha este frame.
    if (dt > 0.0 && (instances[slot].flags.z & VFX_EMITS_CHANNEL) != 0u && (push.pad & VFX_PAD_CHANNELS) != 0u) {
        vec3 world_position = simToWorld(slot, pos);
        vec3 world_velocity = mat3(instances[slot].transform) * vel;
        for (uint b = first; b < first + count; ++b) {
            uint type = blocks[b].info.x;
            if (type == B_EMIT_ON_DEATH && dying) {
                emitChannel(blocks[b], p, world_position, world_velocity, P2, seed);
            } else if (type == B_EMIT_ON_COLLISION && collided && impact >= blocks[b].b.w) {
                emitChannel(blocks[b], p, world_position, world_velocity, P2, seed);
            } else if (type == B_EMIT_EVERY && !dying) {
                // Cada vez que su edad pasa un multiplo del periodo.
                float period = max(blocks[b].b.w, 0.01);
                if (floor(age / period) > floor(P0.w / period)) {
                    emitChannel(blocks[b], p, world_position, world_velocity, P2, seed);
                }
            }
        }
    }

    if (dying) {
        // Muere: vuelve a la pila.
        particles[p * 4u + 1u] = vec4(vel, 0.0);
        int top = atomicAdd(counters[base + 0u], 1);
        dead_list[offset + uint(top)] = p;
        return;
    }
    particles[p * 4u + 0u] = vec4(pos, age);
    particles[p * 4u + 1u] = vec4(vel, lifetime);
    particles[p * 4u + 3u] = P3;
    int slot_alive = atomicAdd(counters[base + 5u], 1);
    alive_list[offset + uint(slot_alive)] = p;
    atomicAdd(counters[base + 1u], 1);
    // Salida Luz: si su efecto da luz (una lectura; sin luz, nada mas).
    emitParticleLight(slot, i, p, pos, vel, age, lifetime, P2);
}

// ---------------------------------------------------------------------------
// SORT: las vivas de un efecto con mezcla alfa, de atras adelante. La lista
// de vivas sale de UPDATE en el orden de los atomicos (cambia cada frame): sin
// ordenar, las de delante quedaban tapadas por las de detras a saltos.
//
// Ordenacion bitonica con pasos "flip" y "disperse" (todas las comparaciones
// en el mismo sentido): las posiciones desde `count` (vivas) se tratan como
// infinitas y nunca se tocan, asi que vale para cualquier numero de vivas.
// Los pasos cortos (alturas <= 128) van en memoria compartida, un bloque de
// 128 por grupo de 64 hilos.
// ---------------------------------------------------------------------------

const uint SORT_BLOCK = 128u;  // 2 x local_size_x
const float SORT_FAR = 3.0e38;  // fuera de las vivas: al final

shared float sort_key[SORT_BLOCK];
shared uint sort_item[SORT_BLOCK];

// Menor = antes: la mas lejana primero. Las cintas, por edad: la mas nueva
// primero (la cabeza, junto al emisor) y cada una junto a la que nacio antes.
// Con varias cintas (VFX_RIBBON_IDS): por (id, edad), el id en la parte alta
// y la edad en ms debajo (id * 65536 + ms < 2^24: exacto en un float).
float sortKey(uint slot, uint p) {
    if (instances[slot].extra.x == VFX_OUT_RIBBON) {
        float age = particles[p * 4u + 0u].w;
        if ((instances[slot].flags.z & VFX_RIBBON_IDS) == 0u) return age;
        uint id = vfxRibbonId(particles[p * 4u + 3u].y);
        return float(id) * 65536.0 + clamp(age * 1024.0, 0.0, 65535.0);
    }
    vec3 d = simToWorld(slot, particles[p * 4u + 0u].xyz) - frame.camera.xyz;
    return -dot(d, d);
}

// Vivas que entran en la ordenacion (como mucho su tamano).
uint sortCount(uint slot) {
    uint base = instances[slot].range.z * 8u;
    uint alive = uint(max(counters[base + 1u], 0));
    return min(min(alive, instances[slot].range.y), push.pad);
}

// Pareja (i, l) de un paso para el hilo t: flip (espejo dentro del bloque de
// altura h) o disperse (separadas h/2).
uvec2 sortPair(uint t, uint h, bool flip) {
    uint half_h = h >> 1u;
    uint q = ((2u * t) / h) * h;
    uint i = q + t % half_h;
    uint l = flip ? q + h - 1u - t % half_h : i + half_h;
    return uvec2(i, l);
}

void sortGlobalStep(uint slot, bool flip) {
    uint t = gl_GlobalInvocationID.x;
    if (t >= push.pad / 2u) return;
    uvec2 pair = sortPair(t, push.count, flip);
    if (pair.y >= sortCount(slot)) return;  // la otra es "infinita": ya en orden
    uint offset = instances[slot].range.x;
    uint a = alive_list[offset + pair.x];
    uint b = alive_list[offset + pair.y];
    if (sortKey(slot, a) > sortKey(slot, b)) {
        alive_list[offset + pair.x] = b;
        alive_list[offset + pair.y] = a;
    }
}

void sortLocalCompare(uint t, uint h, bool flip) {
    uvec2 pair = sortPair(t, h, flip);
    if (sort_key[pair.x] > sort_key[pair.y]) {
        float k = sort_key[pair.x];
        sort_key[pair.x] = sort_key[pair.y];
        sort_key[pair.y] = k;
        uint item = sort_item[pair.x];
        sort_item[pair.x] = sort_item[pair.y];
        sort_item[pair.y] = item;
    }
}

// Sin return antes de los barrier(): todos los hilos del grupo los pasan.
void sortLocal(uint slot, bool full) {
    uint t = gl_LocalInvocationID.x;
    uint block = gl_WorkGroupID.x * SORT_BLOCK;
    uint count = sortCount(slot);
    uint offset = instances[slot].range.x;
    for (uint k = 0u; k < 2u; ++k) {
        uint local_index = t + k * (SORT_BLOCK / 2u);
        uint g = block + local_index;
        if (g < count) {
            uint p = alive_list[offset + g];
            sort_item[local_index] = p;
            sort_key[local_index] = sortKey(slot, p);
        } else {
            sort_item[local_index] = 0u;
            sort_key[local_index] = SORT_FAR;
        }
    }
    barrier();
    if (full) {
        for (uint h = 2u; h <= SORT_BLOCK; h <<= 1u) {
            sortLocalCompare(t, h, true);
            barrier();
            for (uint hh = h >> 1u; hh > 1u; hh >>= 1u) {
                sortLocalCompare(t, hh, false);
                barrier();
            }
        }
    } else {
        for (uint hh = SORT_BLOCK; hh > 1u; hh >>= 1u) {
            sortLocalCompare(t, hh, false);
            barrier();
        }
    }
    for (uint k = 0u; k < 2u; ++k) {
        uint local_index = t + k * (SORT_BLOCK / 2u);
        uint g = block + local_index;
        if (g < count) alive_list[offset + g] = sort_item[local_index];
    }
}

void main() {
    if (push.stage == STAGE_RESET) {
        stageReset(push.slot);
    } else if (push.stage == STAGE_BEGIN) {
        stageBegin();
    } else if (push.stage == STAGE_EMIT) {
        stageEmit(push.slot);
    } else if (push.stage == STAGE_EMIT_EVENTS) {
        stageEmitEvents(push.slot);
    } else if (push.stage == STAGE_EMIT_CHANNEL) {
        stageEmitChannel(push.slot);
    } else if (push.stage == STAGE_UPDATE) {
        stageUpdate(push.slot);
    } else if (push.stage == STAGE_SORT_LOCAL) {
        sortLocal(push.slot, true);
    } else if (push.stage == STAGE_SORT_LOCAL_DISPERSE) {
        sortLocal(push.slot, false);
    } else {
        sortGlobalStep(push.slot, push.stage == STAGE_SORT_FLIP);
    }
}
