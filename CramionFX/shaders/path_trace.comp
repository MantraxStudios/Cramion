#version 460
#extension GL_GOOGLE_include_directive : require

// Path tracing (como el Path Tracer de Unreal): la imagen de referencia de la
// escena con luz fisicamente correcta. Cada frame, un camino por pixel:
//
//   - el primer punto sale del G-buffer (con normal maps, terreno y voxeles);
//   - desde ahi rebota por la escena REAL con rayos por hardware (la misma
//     escena que la GI y los reflejos, rt_common.glsl) muestreando el
//     material: difuso de Lambert o especular GGX (muestreo VNDF de Heitz);
//   - en cada punto, luz directa con rayo de sombra: el sol (con el tamano de
//     su disco: penumbra real) y una luz local elegida al azar;
//   - lo que escapa ve el cielo (el entorno del IBL); ruleta rusa a partir
//     del tercer rebote.
//
// Los caminos se suman en `accumulation` mientras nada cambie (camara, luces,
// objetos): el ruido baja frame a frame hasta la imagen limpia. La media se
// escribe en la imagen HDR de la escena, antes del vidrio, el agua y el
// post-procesado.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "rt_common.glsl"
#include "path_trace_common.glsl"

bool traceBounce(vec3 origin, vec3 direction, float max_distance, out RtHit hit) {
    return traceRay(origin, direction, max_distance, hit);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(output_image);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }
    pathTracePixel(pixel, size);
}
