#version 450

// Sonda de reflexion: prefiltra por rugosidad el cubo capturado de la escena
// (ReflectionProbe), igual que ibl_prefilter.comp hace con el cielo. El nivel
// k corresponde a rugosidad k / (niveles - 1).
//
// A diferencia del cielo, la escena tiene detalle fino y mucho contraste
// (ventanas soleadas junto a rincones oscuros): con pocas muestras GGX
// saldrian destellos. Se usa "filtered importance sampling" (Krivanek y
// Colbert, GPU Gems 3, cap. 20): cada muestra lee el mip de la captura cuyo
// texel cubre el angulo solido que le toca, asi 64 muestras bastan.
//
// El alfa de la captura es la distancia de la sonda a la superficie vista en
// cada direccion; se conserva sin filtrar para la correccion de paralaje de
// lighting.frag.
//
// Se lanza una vez por nivel: (tamano/8, tamano/8, 6 caras).

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform samplerCube capture;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2DArray probe_level;

layout(push_constant) uniform PushConstants {
    float roughness;
    uint face_size;     // lado de este nivel
    uint sample_count;
    float capture_size; // lado del nivel 0 de la captura
} push;

const float kPi = 3.14159265;

// Igual que en ibl_prefilter.comp (convencion de Vulkan: +X, -X, +Y, -Y, +Z, -Z).
vec3 cubeDirection(uint face, vec2 uv) {
    switch (face) {
        case 0u: return normalize(vec3(1.0, -uv.y, -uv.x));
        case 1u: return normalize(vec3(-1.0, -uv.y, uv.x));
        case 2u: return normalize(vec3(uv.x, 1.0, uv.y));
        case 3u: return normalize(vec3(uv.x, -1.0, -uv.y));
        case 4u: return normalize(vec3(uv.x, -uv.y, 1.0));
        default: return normalize(vec3(-uv.x, -uv.y, -1.0));
    }
}

float radicalInverse(uint bits) {
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    return float(bits) * 2.3283064365386963e-10;
}

vec3 importanceSampleGgx(vec2 xi, vec3 n, float alpha) {
    float phi = 2.0 * kPi * xi.x;
    float cos_theta = sqrt((1.0 - xi.y) / (1.0 + (alpha * alpha - 1.0) * xi.y));
    float sin_theta = sqrt(1.0 - cos_theta * cos_theta);
    vec3 h = vec3(sin_theta * cos(phi), sin_theta * sin(phi), cos_theta);

    vec3 up = abs(n.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(up, n));
    vec3 bitangent = cross(n, tangent);
    return normalize(tangent * h.x + bitangent * h.y + n * h.z);
}

float distributionGgx(float n_dot_h, float alpha) {
    float a2 = alpha * alpha;
    float d = n_dot_h * n_dot_h * (a2 - 1.0) + 1.0;
    return a2 / (kPi * d * d);
}

void main() {
    uvec3 id = gl_GlobalInvocationID;
    if (id.x >= push.face_size || id.y >= push.face_size) {
        return;
    }

    vec2 uv = (vec2(id.xy) + 0.5) / float(push.face_size) * 2.0 - 1.0;
    vec3 n = cubeDirection(id.z, uv);

    // Distancia sin filtrar (la del texel central de la captura).
    float distance_to_surface = textureLod(capture, n, 0.0).a;

    vec3 color;
    if (push.roughness <= 0.0) {
        // Espejo: el mip de la captura con el mismo tamano que este nivel.
        color = textureLod(capture, n, log2(push.capture_size / float(push.face_size))).rgb;
    } else {
        // V = N = R, como en el split-sum.
        float alpha = push.roughness * push.roughness;
        // Angulo solido de un texel del nivel 0 de la captura.
        float texel_solid_angle = 4.0 * kPi / (6.0 * push.capture_size * push.capture_size);

        vec3 sum = vec3(0.0);
        float weight = 0.0;
        for (uint i = 0u; i < push.sample_count; ++i) {
            vec2 xi = vec2(float(i) / float(push.sample_count), radicalInverse(i));
            vec3 h = importanceSampleGgx(xi, n, alpha);
            float n_dot_h = max(dot(n, h), 0.0);
            vec3 l = normalize(2.0 * n_dot_h * h - n);
            float n_dot_l = dot(n, l);
            if (n_dot_l <= 0.0) {
                continue;
            }
            // pdf de la direccion reflejada con V = N: D * NdotH / (4 VdotH) = D / 4.
            float pdf = distributionGgx(n_dot_h, alpha) * 0.25;
            float sample_solid_angle = 1.0 / (float(push.sample_count) * pdf + 0.0001);
            float lod = max(0.5 * log2(sample_solid_angle / texel_solid_angle) + 1.0, 0.0);

            // Media de Karis: las fuentes diminutas y muy brillantes
            // (bombillas emisivas, el sol reflejado) no dejan manchas en los
            // niveles rugosos.
            vec3 radiance = textureLod(capture, l, lod).rgb;
            float w = n_dot_l / (1.0 + dot(radiance, vec3(0.2126, 0.7152, 0.0722)));
            sum += radiance * w;
            weight += w;
        }
        color = sum / max(weight, 0.0001);
    }

    imageStore(probe_level, ivec3(id), vec4(color, distance_to_surface));
}
