#version 450

// Acumulacion temporal de los reflejos por rayos (rt_reflections.comp), a
// resolucion completa (primer paso del filtro; despues rt_reflection_atrous).
//
// rt_reflections.comp lanza UN rayo por pixel en una direccion al azar del
// lobulo de la rugosidad. En un espejo todos los rayos van al mismo sitio (sin
// ruido); en una superficie satinada cada pixel ve otra cosa cada frame: un
// grano que bailaba sobre todo lo brillante. Antes solo se mezclaba con un
// peso fijo (0.88) y un recorte min/max de 3x3 que, con ese ruido, apenas
// quitaba nada.
//
// Como la GI (gi_temporal.comp, SVGF), cada pixel lleva cuantos frames de
// historia tiene (n) y mezcla con alfa = 1/n hasta un tope que depende de la
// rugosidad: un espejo guarda pocos frames (su reflejo se mueve con la camara
// y no tiene ruido que quitar) y lo rugoso hasta ~40. La historia se lee
// reproyectada dos veces (bilineal, solo de texeles de la misma superficie):
// con el movimiento de la superficie (camara + vector de movimiento del
// G-buffer) y con el del punto virtual reflejado (lo que se ve en el espejo,
// tipo ReBLUR), mezcladas segun la rugosidad; cada una se recorta
// a la media +- gamma desviaciones de la vecindad 3x3 de este frame (mas
// estricto en lo pulido): lo que cambio de verdad no deja estela. Los puntos
// sueltos muy brillantes (un rayo que dio en el sol) se recortan antes.
//
// Salida: rgb = reflejo acumulado, a = varianza de su luminancia (guia el
// filtro espacial); y los momentos (E[L], E[L^2], frames, profundidad lineal)
// que se copian a la historia con el color.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform CameraBuffer {
    mat4 view;
    mat4 projection;
    mat4 view_projection;
    mat4 inverse_view_projection;
    vec4 position;
    mat4 unjittered_view_projection;
    mat4 previous_view_projection;  // sin jitter (la de los vectores de movimiento)
} camera;

layout(set = 0, binding = 1) uniform sampler2D g_depth;
layout(set = 0, binding = 2) uniform sampler2D g_normal;            // rg = normal, b = rugosidad
layout(set = 0, binding = 3) uniform sampler2D current_reflection;  // rt_reflections.comp (a = distancia al impacto, 0 = sin trazar)
layout(set = 0, binding = 4) uniform sampler2D history_color;       // acumulado anterior (a = varianza)
layout(set = 0, binding = 5) uniform sampler2D history_moments;     // E[L], E[L^2], frames, profundidad
layout(set = 0, binding = 6, rgba16f) uniform writeonly image2D out_color;
layout(set = 0, binding = 7, rgba16f) uniform writeonly image2D out_moments;
layout(set = 0, binding = 8) uniform sampler2D velocity_map;        // UV actual - UV anterior (sin jitter)
// Para el filtro espacial: x = distancia al impacto filtrada (mediana 3x3),
// y = frames de historia.
layout(set = 0, binding = 9, rgba16f) uniform writeonly image2D out_aux;

layout(push_constant) uniform PushConstants {
    mat4 previous_view_projection;  // con jitter, como la historia
    vec4 params;  // x = hay historia valida
} push;

const float kMaxRadiance = 30.0;  // igual que rt_common.glsl

float luminance(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

float linearDepth(float depth) {
    return (camera.projection[3][2] - depth * camera.projection[3][3]) / (camera.projection[2][2] - depth * camera.projection[2][3]);
}

vec3 decodeNormal(vec2 e) {
    vec3 n = vec3(e.x, 1.0 - abs(e.x) - abs(e.y), e.y);
    float t = max(-n.y, 0.0);
    n.x += n.x >= 0.0 ? -t : t;
    n.z += n.z >= 0.0 ? -t : t;
    return normalize(n);
}

// Color comprimido (reversible): un punto HDR extremo no domina las medias
// de la vecindad.
vec3 compress(vec3 c) {
    return c / (1.0 + luminance(c));
}
vec3 expand(vec3 c) {
    return c / max(1.0 - luminance(c), 1e-3);
}

// Donde estaba en la historia (con jitter) el punto `world` que se ve en este
// pixel (igual que rt_shadow_temporal.comp): la camara sola es exacta para lo
// quieto; lo que se mueve lleva ademas su propio movimiento (el vector del
// G-buffer menos el que daria la camara, los dos sin jitter).
vec2 previousUv(ivec2 pixel, ivec2 size, vec4 world, vec4 previous_clip, out bool moving) {
    vec2 camera_uv = previous_clip.xy / max(previous_clip.w, 1e-6) * 0.5 + 0.5;
    moving = false;
    vec4 current_unjittered = camera.unjittered_view_projection * world;
    vec4 previous_unjittered = camera.previous_view_projection * world;
    if (current_unjittered.w <= 1e-6 || previous_unjittered.w <= 1e-6) return camera_uv;
    vec2 camera_motion = (current_unjittered.xy / current_unjittered.w - previous_unjittered.xy / previous_unjittered.w) * 0.5;
    vec2 velocity = texelFetch(velocity_map, pixel, 0).xy;
    if (any(greaterThan(abs(velocity), vec2(15.9)))) return camera_uv;
    vec2 object_motion = velocity - camera_motion;
    float threshold = 0.1 + 0.002 * length(camera_motion * vec2(size));
    if (length(object_motion * vec2(size)) <= threshold) return camera_uv;
    moving = true;
    return camera_uv - object_motion;
}

// Bilineal de la historia en `history_uv` con prueba de cada texel: solo
// cuentan los de la misma superficie (su profundidad guardada coincide con
// `expected_depth`). Devuelve el peso total (0 = sin historia ahi).
float fetchHistory(vec2 history_uv, ivec2 size, float expected_depth, float tolerance, out vec4 color,
                   out vec4 moments) {
    color = vec4(0.0);
    moments = vec4(0.0);
    float weight = 0.0;
    if (any(lessThan(history_uv, vec2(0.0))) || any(greaterThan(history_uv, vec2(1.0)))) return 0.0;
    vec2 texel = history_uv * vec2(size) - 0.5;
    ivec2 base = ivec2(floor(texel));
    vec2 f = fract(texel);
    const ivec2 kOffsets[4] = ivec2[](ivec2(0, 0), ivec2(1, 0), ivec2(0, 1), ivec2(1, 1));
    float bilinear[4] = float[]((1.0 - f.x) * (1.0 - f.y), f.x * (1.0 - f.y), (1.0 - f.x) * f.y, f.x * f.y);
    for (int i = 0; i < 4; ++i) {
        ivec2 p = base + kOffsets[i];
        if (any(lessThan(p, ivec2(0))) || any(greaterThanEqual(p, size)) || bilinear[i] <= 0.0) continue;
        vec4 m = texelFetch(history_moments, p, 0);
        if (m.z > 0.0 && abs(m.w - expected_depth) < tolerance) {
            color += texelFetch(history_color, p, 0) * bilinear[i];
            moments += m * bilinear[i];
            weight += bilinear[i];
        }
    }
    if (weight > 0.0) {
        color /= weight;
        moments /= weight;
    }
    return weight;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(out_color);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }

    float depth = texelFetch(g_depth, pixel, 0).r;
    vec4 current = texelFetch(current_reflection, pixel, 0);
    vec4 normal_sample = texelFetch(g_normal, pixel, 0);
    // Cielo o demasiado rugoso (lo pone el IBL): nada que acumular.
    if (depth >= 1.0 || current.a <= 0.0) {
        imageStore(out_color, pixel, vec4(clamp(current.rgb, vec3(0.0), vec3(kMaxRadiance)), 0.0));
        imageStore(out_moments, pixel, vec4(0.0, 0.0, 0.0, depth >= 1.0 ? 0.0 : linearDepth(depth)));
        imageStore(out_aux, pixel, vec4(0.0));
        return;
    }
    float view_depth = linearDepth(depth);
    vec3 center_normal = decodeNormal(normal_sample.rg);
    float roughness = normal_sample.b;
    // 0 = espejo .. 1 = satinado/rugoso.
    float rough = smoothstep(0.03, 0.45, roughness);

    // --- Vecindad 3x3 de este frame (misma superficie) ---
    vec3 m1 = vec3(0.0);
    vec3 m2 = vec3(0.0);
    vec2 l_moments = vec2(0.0);
    float count = 0.0;
    // Distancias al impacto de la vecindad (para su mediana).
    float hits[9];
    int hit_count = 0;
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            ivec2 q = clamp(pixel + ivec2(dx, dy), ivec2(0), size - 1);
            if (dx != 0 || dy != 0) {
                float qz = texelFetch(g_depth, q, 0).r;
                if (qz >= 1.0 || abs(linearDepth(qz) - view_depth) > view_depth * 0.05 + 0.02) continue;
                vec4 qn = texelFetch(g_normal, q, 0);
                if (dot(decodeNormal(qn.rg), center_normal) < 0.85 || abs(qn.b - roughness) > 0.2) continue;
            }
            vec4 sample_reflection = texelFetch(current_reflection, q, 0);
            if (sample_reflection.a > 0.0) {
                // Insercion ordenada (como mucho 9).
                int j = hit_count;
                while (j > 0 && hits[j - 1] > sample_reflection.a) {
                    hits[j] = hits[j - 1];
                    --j;
                }
                hits[j] = sample_reflection.a;
                ++hit_count;
            }
            vec3 c = clamp(sample_reflection.rgb, vec3(0.0), vec3(kMaxRadiance));
            vec3 cc = compress(c);
            m1 += cc;
            m2 += cc * cc;
            float l = luminance(c);
            l_moments += vec2(l, l * l);
            count += 1.0;
        }
    }
    vec3 mean = m1 / count;
    vec3 sigma = sqrt(max(m2 / count - mean * mean, vec3(0.0)));

    // Punto suelto muy brillante (fireflie): al rango de sus vecinos.
    vec3 current_compressed = compress(clamp(current.rgb, vec3(0.0), vec3(kMaxRadiance)));
    current_compressed = min(current_compressed, mean + sigma * mix(4.0, 1.5, rough) + 0.02);
    vec3 current_color = expand(current_compressed);

    // Distancia al impacto filtrada: la mediana de la vecindad (la de un rayo
    // suelto salta de un objeto al cielo de un pixel al siguiente). Su
    // dispersion (rango intercuartil relativo) dice cuanto fiarse de ella:
    // en el borde de un objeto reflejado no hay una sola distancia.
    float hit_distance = hits[hit_count / 2];
    float hit_spread = (hits[min((hit_count * 3) / 4, hit_count - 1)] - hits[hit_count / 4]) / max(hit_distance, 1e-3);
    float hit_confidence = clamp(1.0 - hit_spread * 2.0, 0.0, 1.0);

    // --- Donde estaba este punto de la superficie el frame anterior ---
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    vec4 world = camera.inverse_view_projection * vec4(uv * 2.0 - 1.0, depth, 1.0);
    world /= world.w;
    vec4 previous_clip = push.previous_view_projection * world;
    bool moving;
    vec2 previous_uv = previousUv(pixel, size, world, previous_clip, moving);

    // --- Y donde estaba lo reflejado (reproyeccion del punto virtual) ---
    // Lo reflejado se ve detras del espejo, a la distancia de su impacto: el
    // punto virtual (superficie + impacto a lo largo del rayo de la vista).
    // Al moverse la camara el reflejo resbala sobre la superficie: la
    // historia que le corresponde esta donde se veia ese punto virtual, no
    // donde estaba la superficie (antes solo se leia esta y en lo pulido se
    // cortaba la historia a 3 frames: estela o ruido al andar).
    vec3 to_surface = world.xyz - camera.position.xyz;
    float surface_distance = length(to_surface);
    vec3 virtual_point = camera.position.xyz + to_surface * ((surface_distance + hit_distance) / max(surface_distance, 1e-4));
    vec4 virtual_clip = push.previous_view_projection * vec4(virtual_point, 1.0);
    vec2 virtual_uv = virtual_clip.xy / max(virtual_clip.w, 1e-6) * 0.5 + 0.5;
    float parallax = virtual_clip.w > 0.0 ? length((virtual_uv - previous_uv) * vec2(size)) : 1e3;

    bool history_enabled = push.params.x > 0.5 && previous_clip.w > 0.0;
    vec4 surface_color;
    vec4 surface_moments;
    float surface_weight = 0.0;
    if (history_enabled) {
        float tolerance = previous_clip.w * (moving ? 0.1 : 0.04) + 0.03;
        surface_weight = fetchHistory(previous_uv, size, previous_clip.w, tolerance, surface_color, surface_moments);
    }
    // Lectura virtual: lo que se veia en virtual_uv tiene que ser esta misma
    // superficie (un plano). La profundidad esperada ahi: donde el rayo de la
    // camara anterior hacia el punto virtual corta el plano de la superficie
    // (w de recorte lineal a lo largo de ese rayo: t * w(virtual)). Con algo
    // que se mueve no se usa (su reflejo no sigue a la camara).
    vec4 virtual_color;
    vec4 virtual_moments;
    float virtual_weight = 0.0;
    if (history_enabled && !moving && virtual_clip.w > 0.0 && parallax > 0.05) {
        vec4 previous_camera = inverse(push.previous_view_projection) * vec4(0.0, 0.0, 1.0, 0.0);
        if (abs(previous_camera.w) > 1e-8) {
            vec3 eye = previous_camera.xyz / previous_camera.w;
            float facing = dot(virtual_point - eye, center_normal);
            if (abs(facing) > 1e-4) {
                float t = dot(world.xyz - eye, center_normal) / facing;
                float expected = t * virtual_clip.w;
                if (t > 0.0 && t < 1.0) {
                    virtual_weight = fetchHistory(virtual_uv, size, expected, expected * 0.06 + 0.05, virtual_color,
                                                  virtual_moments);
                }
            }
        }
    } else if (surface_weight > 0.0) {
        // Sin paralaje las dos lecturas son la misma.
        virtual_color = surface_color;
        virtual_moments = surface_moments;
        virtual_weight = surface_weight;
    }
    bool surface_valid = surface_weight > 0.05;
    bool virtual_valid = virtual_weight > 0.05;
    // Peso de la lectura virtual: mas cuanto mas pulido y cuanto mas fiable
    // la distancia; en un espejo (rugosidad < 0.05, el rayo es el mismo cada
    // frame y la distancia exacta) casi todo.
    float w_virtual = 0.0;
    if (virtual_valid) {
        w_virtual = clamp((1.0 - roughness) * hit_confidence, 0.0, 1.0);
        if (roughness < 0.05) w_virtual = max(w_virtual, 0.9);
        if (!surface_valid) w_virtual = 1.0;
    }
    bool valid = surface_valid || virtual_valid;

    float frames = 1.0;
    vec3 color = current_color;
    vec2 moments = vec2(luminance(current_color), luminance(current_color) * luminance(current_color));
    if (valid) {
        // Recorte de cada lectura a la vecindad (mas estricto cuanto mas pulido).
        float gamma = mix(1.25, 3.0, rough);
        vec3 low = mean - sigma * gamma - 0.01;
        vec3 high = mean + sigma * gamma + 0.01;
        vec3 clipped = vec3(0.0);
        float change = 0.0;
        vec4 previous_moments = vec4(0.0);
        if (w_virtual < 1.0) {
            vec3 previous_compressed = compress(max(surface_color.rgb, vec3(0.0)));
            vec3 c = clamp(previous_compressed, low, high);
            float w = 1.0 - w_virtual;
            clipped += c * w;
            change += luminance(abs(c - previous_compressed)) / max(luminance(previous_compressed), 0.02) * w;
            previous_moments += surface_moments * w;
        }
        if (w_virtual > 0.0) {
            vec3 previous_compressed = compress(max(virtual_color.rgb, vec3(0.0)));
            vec3 c = clamp(previous_compressed, low, high);
            clipped += c * w_virtual;
            change += luminance(abs(c - previous_compressed)) / max(luminance(previous_compressed), 0.02) * w_virtual;
            previous_moments += virtual_moments * w_virtual;
        }

        float max_frames = mix(6.0, 40.0, rough);
        // Lo que resbala (pixeles de paralaje) y no cubre la lectura virtual,
        // en lo pulido: pocos frames.
        max_frames = mix(max_frames, 3.0, clamp(parallax * (1.0 - rough) * (1.0 - w_virtual) * 0.5, 0.0, 1.0));
        frames = min(previous_moments.z + 1.0, max_frames);
        // La luz cambio de verdad (se apago algo, paso un objeto): la
        // historia se acorta en proporcion y converge en pocos frames.
        if (change > 0.05) {
            frames = min(frames, mix(frames, 2.0, clamp(change * 2.0, 0.0, 1.0)));
        }
        float alpha = 1.0 / frames;
        color = mix(expand(clipped), current_color, alpha);
        moments = mix(previous_moments.xy, moments, max(alpha, 0.2));
    }

    float variance = max(moments.y - moments.x * moments.x, 0.0);
    // Poca historia: la varianza de la vecindad (mas prudente).
    if (frames < 4.0) {
        vec2 spatial = l_moments / count;
        variance = max(variance, max(spatial.y - spatial.x * spatial.x, 0.0) * (4.0 / frames));
    }

    // Al filtro espacial le importa el ruido que le queda a lo ACUMULADO (la
    // media de `frames` rayos), no el de un rayo suelto: recien destapado es
    // todo el del rayo y se filtra fuerte; con la historia llena apenas queda
    // y el filtro no emborrona nada.
    imageStore(out_color, pixel, vec4(clamp(color, vec3(0.0), vec3(kMaxRadiance)), variance / frames));
    imageStore(out_moments, pixel, vec4(moments, frames, view_depth));
    imageStore(out_aux, pixel, vec4(hit_distance, frames, 0.0, 0.0));
}
