#version 460
#extension GL_GOOGLE_include_directive : require

// Reflejos con trazado de rayos por hardware (sustituyen al SSR y a la sonda
// de reflexion), a resolucion completa. Un rayo por pixel contra la escena
// real: refleja lo que hay fuera de pantalla y detras de la camara igual que
// lo de delante, sin capturas.
//
// La direccion sigue el lobulo GGX de la rugosidad (muestreo de importancia,
// distinto cada frame): con el filtro (rt_reflection_temporal.comp y
// rt_reflection_atrous.comp) la media es el reflejo borroso que corresponde,
// lo mismo que el entorno prefiltrado del IBL. En superficies muy rugosas no
// se traza: lo pone el IBL.
//
// Se muestrean las normales VISIBLES desde la camara (Heitz 2018, "Sampling
// the GGX Distribution of Visible Normals"), no la distribucion entera: no
// salen direcciones por debajo de la superficie ni las de mucho peso y poca
// probabilidad que daban puntos sueltos muy brillantes. Con la misma
// rugosidad, mucho menos ruido por rayo.
//
// Salida (igual que ssr.frag): rgb = luz reflejada, a = confianza.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "rt_common.glsl"

const float kMaxRoughness = 0.65;
const float kMaxDistance = 1000.0;
const float kEnvironmentMaxLod = 5.0;  // IblProbe::kEnvironmentMips - 1
// Se recorta la cola del lobulo (los rayos casi rasantes del borde del
// disco): apenas cambia el reflejo y quita la mayor parte del ruido.
const float kLobeTrim = 0.85;

// Normal visible de GGX (Heitz 2018) en el espacio de la superficie (z =
// normal). `view` hacia la camara, `alpha` = rugosidad^2.
vec3 sampleGgxVisibleNormal(vec3 view, float alpha, vec2 u) {
    vec3 stretched = normalize(vec3(alpha * view.x, alpha * view.y, view.z));
    float length_squared = stretched.x * stretched.x + stretched.y * stretched.y;
    vec3 t1 = length_squared > 0.0 ? vec3(-stretched.y, stretched.x, 0.0) * inversesqrt(length_squared)
                                   : vec3(1.0, 0.0, 0.0);
    vec3 t2 = cross(stretched, t1);
    float r = sqrt(u.x * kLobeTrim);
    float phi = 2.0 * kPi * u.y;
    float p1 = r * cos(phi);
    float p2 = r * sin(phi);
    float s = 0.5 * (1.0 + stretched.z);
    p2 = (1.0 - s) * sqrt(max(1.0 - p1 * p1, 0.0)) + s * p2;
    vec3 h = p1 * t1 + p2 * t2 + sqrt(max(1.0 - p1 * p1 - p2 * p2, 0.0)) * stretched;
    return normalize(vec3(alpha * h.x, alpha * h.y, max(h.z, 1e-6)));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(output_image);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }

    float depth = texelFetch(g_depth, pixel, 0).r;
    vec4 normal_sample = texelFetch(g_normal, pixel, 0);
    float roughness = normal_sample.b;
    if (depth >= 1.0 || roughness > kMaxRoughness) {
        imageStore(output_image, pixel, vec4(0.0));
        return;
    }

    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    vec3 position = worldFromDepth(uv, depth);
    vec3 normal = decodeNormal(normal_sample.rg);
    vec3 to_camera = camera.position.xyz - position;
    float distance_to_camera = length(to_camera);
    vec3 view_direction = to_camera / max(distance_to_camera, 0.0001);

    // Direccion reflejada: espejo, o una muestra del lobulo GGX (normales
    // visibles, en la base de la normal de sombreado).
    vec3 direction = reflect(-view_direction, normal);
    if (roughness > 0.05) {
        vec3 up = abs(normal.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
        vec3 tangent = normalize(cross(up, normal));
        vec3 bitangent = cross(normal, tangent);
        vec3 local_view = vec3(dot(view_direction, tangent), dot(view_direction, bitangent),
                               max(dot(view_direction, normal), 1e-4));
        vec2 xi = sampleNoise(vec2(pixel), 0.0);
        vec3 h = sampleGgxVisibleNormal(local_view, roughness * roughness, xi);
        vec3 halfway = normalize(tangent * h.x + bitangent * h.y + normal * h.z);
        vec3 sampled = reflect(-view_direction, halfway);
        if (dot(sampled, normal) > 0.0) {
            direction = sampled;
        }
    }

    // El origen, separado a lo largo de la cara real (no del normal map).
    vec3 geometric = gbufferGeometricNormal(pixel, position, normal);
    vec3 origin = position + geometric * gbufferRayBias(distance_to_camera, 0.01);
    // Que el rayo no salga hacia dentro de la cara real (normal map muy
    // inclinado): se tuerce hasta su plano.
    float below = dot(direction, geometric);
    if (below < 0.02) {
        direction = normalize(direction + geometric * (0.02 - below));
    }
    RtHit hit;
    vec3 color;
    if (traceRay(origin, direction, kMaxDistance, hit)) {
        // Texturas mas borrosas lejos y en superficies rugosas.
        float lod = clamp(log2(1.0 + hit.distance * (0.05 + roughness)), 0.0, 6.0);
        color = hitRadiance(hit, lod, true);
    } else {
        // Cielo (y suelo lejano) del IBL. La direccion ya es una muestra del
        // lobulo (GGX) y los filtros la promedian: el mip de la rugosidad
        // entera emborronaba dos veces (reflejos mas borrosos que el IBL con
        // el que se mezclan). Un desenfoque de un tercio de la rugosidad
        // quita ruido y ensancha el lobulo apenas un 6 %.
        color = textureLod(environment_map, direction, roughness * kEnvironmentMaxLod * 0.35).rgb;
    }

    // Entre kMaxRoughness * 0.75 y kMaxRoughness pasa suavemente al IBL.
    float confidence = 1.0 - smoothstep(kMaxRoughness * 0.75, kMaxRoughness, roughness);
    imageStore(output_image, pixel, vec4(min(color, vec3(kMaxRadiance)), confidence));
}
