#version 460
#extension GL_GOOGLE_include_directive : require

// Sombras por rayos de las luces locales (puntuales y focos), a resolucion
// completa. En cada pixel se eligen las 4 luces que mas luz le aportan (sin
// sombra: intensidad, distancia, angulo y cono) y se lanza un rayo de sombra
// hacia un punto al azar de la bombilla de cada una (el disco de su "Radio de
// la fuente", perpendicular a la luz). Con una bombilla pequena la sombra es
// nitida; con una grande, el borde se difumina segun la distancia entre lo que
// tapa y lo que recibe (penumbra real). El punto cambia cada frame y
// lighting.frag promedia los vecinos: el TAA hace el resto.
//
// Vale para TODAS las luces locales (no solo las que tienen mapa de sombras),
// pero solo con lo que hay en la escena de rayos (el escenario). Los
// personajes animados, el terreno y los voxeles siguen proyectando con los
// mapas de sombras; lighting.frag se queda con la mas oscura de las dos.
//
// Salida (RGBA16F, un canal por luz): (luz + 1) * 32 + visibilidad (31 = llega;
// 0..30 = tapado, con el ancho de su penumbra: encodeVisibility); 0 = hueco
// libre. Las luces se numeran: puntuales 0..31, focos 32..39. Enteros
// < 2048: exactos en 16 bits. Es un rayo por luz y pixel (0 o 1): la
// acumula en el tiempo rt_shadow_temporal.comp y la iluminacion lee el
// resultado (sin eso la penumbra era ruido que cambiaba cada frame).
//
// El origen del rayo se separa a lo largo de la normal de la cara real (de la
// profundidad), no de la del normal map, y una luz que la cara real no ve no se
// traza (la pone a oscuras el propio N.L): asi el borde de la sombra de una
// malla de pocos poligonos no se llena de facetas que parpadean.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "rt_common.glsl"

const int kSlots = 4;
// Como LocalLightShadows::kNearPlane: lo que esta a menos de 20 cm de la luz
// (su bombilla, el poste de la farola) no tapa.
const float kNearPlane = 0.2;
// El sol ocupa un hueco mas con este numero de luz (lighting.frag: kRtSunId).
// Va primero: es la luz que mas aporta de dia. Un rayo hacia un punto al azar
// de su disco (0.53 grados): sombra nitida al pie de las cosas y que se
// difumina con la distancia (penumbra real). Ve el escenario y el terreno con
// su forma exacta y llega mas alla de las cascadas (la sombra de una montana
// al atardecer a kilometros). Los arboles no: en el raster se mecen con el
// viento y su sombra la pone el mapa de cascadas. lighting.frag se queda con
// la mas oscura de las dos.
const int kSunId = kMaxPointLights + kMaxSpotLights;
const float kSunAngularRadius = 0.00465;

// Como unoccludedMask (rt_common.glsl) pero devuelve la distancia al primer
// impacto que encuentra (-1 = nada tapa). No es la del mas cercano (el rayo
// acaba en el primero), pero basta para estimar el tamano de la penumbra.
float occluderDistance(vec3 origin, vec3 direction, float max_distance, uint mask) {
    rayQueryEXT query;
    rayQueryInitializeEXT(query, scene_tlas, gl_RayFlagsTerminateOnFirstHitEXT, mask, origin,
                          0.0, direction, max_distance);
    while (rayQueryProceedEXT(query)) {
        if (rayQueryGetIntersectionTypeEXT(query, false) ==
                gl_RayQueryCandidateIntersectionTriangleEXT &&
            candidateIsOpaque(query)) {
            rayQueryConfirmIntersectionEXT(query);
        }
    }
    if (rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionNoneEXT) {
        return -1.0;
    }
    return rayQueryGetIntersectionTEXT(query, true);
}

// Visibilidad de un rayo en 5 bits: 31 = llega a la luz; 0..30 = tapado, con
// el ancho de la penumbra en ese punto (en el mundo) en escala logaritmica:
// 5 mm * 2^(codigo / 3), de 5 mm a ~5 m. Penumbra = diametro de la bombilla *
// (receptor -> lo que tapa) / (lo que tapa -> luz). rt_shadow_temporal.comp
// la usa para el radio del filtro espacial (rt_shadow_spatial.comp).
float encodeVisibility(float occluder, float penumbra_width) {
    if (occluder < 0.0) return 31.0;
    return clamp(round(log2(max(penumbra_width, 0.005) / 0.005) * 3.0), 0.0, 30.0);
}

void insertLight(int id, float score, inout int ids[kSlots], inout float scores[kSlots]) {
    if (score <= scores[kSlots - 1]) return;
    int k = kSlots - 1;
    while (k > 0 && scores[k - 1] < score) {
        ids[k] = ids[k - 1];
        scores[k] = scores[k - 1];
        --k;
    }
    ids[k] = id;
    scores[k] = score;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(output_image);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }

    float depth = texelFetch(g_depth, pixel, 0).r;
    if (depth >= 1.0) {
        imageStore(output_image, pixel, vec4(0.0));
        return;
    }
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    vec3 position = worldFromDepth(uv, depth);
    vec3 normal = decodeNormal(texelFetch(g_normal, pixel, 0).rg);

    // --- Las 4 luces que mas aportan (el sol, si toca, la primera) ---
    // push.params.z: 1 = luces locales, 2 = sol (se pueden sumar).
    int flags = int(push.params.z + 0.5);
    bool want_local = (flags & 1) != 0;
    vec3 to_sun = -normalize(lights.sun_direction_intensity.xyz);

    // Ninguna luz le da de cara (el sol por detras y ninguna local cerca): nada
    // que trazar, y la normal de la cara real (5 lecturas de profundidad) no
    // hace falta. Es la mitad de la escena con solo el sol.
    bool any_candidate = (flags & 2) != 0 && dot(normal, to_sun) > 0.0;
    for (int i = 0; want_local && !any_candidate && i < min(lights.counts.x, kMaxPointLights); ++i) {
        vec3 to_light = lights.points[i].position_range.xyz - position;
        any_candidate = lights.points[i].shadow.y > 0.0 &&
                        dot(to_light, to_light) <= lights.points[i].position_range.w * lights.points[i].position_range.w &&
                        dot(normal, to_light) > 0.0;
    }
    for (int i = 0; want_local && !any_candidate && i < min(lights.counts.y, kMaxSpotLights); ++i) {
        vec3 to_light = lights.spots[i].position_range.xyz - position;
        any_candidate = lights.spots[i].outer_shadow.z > 0.0 &&
                        dot(to_light, to_light) <= lights.spots[i].position_range.w * lights.spots[i].position_range.w &&
                        dot(normal, to_light) > 0.0;
    }
    if (!any_candidate) {
        imageStore(output_image, pixel, vec4(0.0));
        return;
    }

    vec3 geometric = gbufferGeometricNormal(pixel, position, normal);
    float distance_to_camera = length(camera.position.xyz - position);
    bool want_sun = (flags & 2) != 0 && dot(normal, to_sun) > 0.0 && dot(geometric, to_sun) > 0.0;
    int ids[kSlots] = int[](-1, -1, -1, -1);
    float scores[kSlots] = float[](0.0, 0.0, 0.0, 0.0);
    if (want_sun) {
        ids[0] = kSunId;
        scores[0] = 3.0e38;
    }
    // La puntuacion usa la normal de la cara real, no la del normal map: con
    // la de sombreado cada pixel del relieve elegia otras 4 luces (manchas
    // donde la eleccion cambiaba de un pixel al siguiente y la historia de
    // esa luz se perdia). Una luz que la cara real ve se traza aunque el
    // relieve la tape en este pixel (la iluminacion ya la pone a 0 con su N.L).
    int point_count = want_local ? min(lights.counts.x, kMaxPointLights) : 0;
    for (int i = 0; i < point_count; ++i) {
        if (lights.points[i].shadow.y <= 0.0) continue;  // sin sombra
        vec3 to_light = lights.points[i].position_range.xyz - position;
        float d = length(to_light);
        float range = lights.points[i].position_range.w;
        if (d > range) continue;
        float n_dot_l = dot(geometric, to_light / max(d, 1e-4));
        if (n_dot_l <= 0.0) continue;
        float score = luminance(lights.points[i].color_intensity.rgb) * lights.points[i].color_intensity.a *
                      attenuation(d, range) * (0.25 + 0.75 * n_dot_l);
        insertLight(i, score, ids, scores);
    }
    int spot_count = want_local ? min(lights.counts.y, kMaxSpotLights) : 0;
    for (int i = 0; i < spot_count; ++i) {
        if (lights.spots[i].outer_shadow.z <= 0.0) continue;
        vec3 to_light = lights.spots[i].position_range.xyz - position;
        float d = length(to_light);
        float range = lights.spots[i].position_range.w;
        if (d > range) continue;
        vec3 l = to_light / max(d, 1e-4);
        float n_dot_l = dot(geometric, l);
        if (n_dot_l <= 0.0) continue;
        float cosine = dot(-l, normalize(lights.spots[i].direction_intensity.xyz));
        float inner_cos = lights.spots[i].color_inner.a;
        float outer_cos = lights.spots[i].outer_shadow.x;
        float cone = clamp((cosine - outer_cos) / max(inner_cos - outer_cos, 1e-4), 0.0, 1.0);
        if (cone <= 0.0) continue;
        float score = luminance(lights.spots[i].color_inner.rgb) * lights.spots[i].direction_intensity.w *
                      cone * cone * attenuation(d, range) * (0.25 + 0.75 * n_dot_l);
        insertLight(kMaxPointLights + i, score, ids, scores);
    }

    // --- Un rayo de sombra por luz ---
    vec3 origin = position + geometric * gbufferRayBias(distance_to_camera, 0.01);
    vec4 result = vec4(0.0);
    for (int k = 0; k < kSlots; ++k) {
        int id = ids[k];
        if (id < 0) continue;
        if (id == kSunId) {
            vec3 sun_tangent = normalize(cross(abs(to_sun.y) < 0.99 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0), to_sun));
            vec3 sun_bitangent = cross(to_sun, sun_tangent);
            vec2 xi = sampleNoise(vec2(pixel), 0.913);
            float r = kSunAngularRadius * sqrt(xi.x);
            float angle = 2.0 * kPi * xi.y;
            vec3 direction = normalize(to_sun + (sun_tangent * cos(angle) + sun_bitangent * sin(angle)) * r);
            float sun_hit = occluderDistance(origin, direction, 20000.0, kMaskScenery | kMaskTerrain);
            // Penumbra del sol: el diametro angular del disco por la distancia.
            result[k] = float(id + 1) * 32.0 + encodeVisibility(sun_hit, sun_hit * 2.0 * kSunAngularRadius);
            continue;
        }
        bool spot = id >= kMaxPointLights;
        vec3 light_position = spot ? lights.spots[id - kMaxPointLights].position_range.xyz
                                   : lights.points[id].position_range.xyz;
        float radius = spot ? lights.spots[id - kMaxPointLights].outer_shadow.w : lights.points[id].shadow.z;

        // Punto al azar del disco de la bombilla, de cara al pixel.
        vec3 to_light = normalize(light_position - origin);
        vec3 up = abs(to_light.y) < 0.99 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
        vec3 tangent = normalize(cross(up, to_light));
        vec3 bitangent = cross(to_light, tangent);
        vec2 xi = sampleNoise(vec2(pixel), float(k) * 0.371);
        float r = radius * sqrt(xi.x);
        float angle = 2.0 * kPi * xi.y;
        vec3 target = light_position + (tangent * cos(angle) + bitangent * sin(angle)) * r;

        vec3 ray = target - origin;
        float length_to_target = length(ray);
        float max_distance = length_to_target - max(kNearPlane, radius);
        float hit = -1.0;
        if (max_distance > 0.0) {
            hit = occluderDistance(origin, ray / length_to_target, max_distance, kMaskAll & ~kMaskNoShadow);
        }
        float penumbra_width = 2.0 * radius * max(hit, 0.0) / max(length_to_target - hit, 0.05);
        result[k] = float(id + 1) * 32.0 + encodeVisibility(hit, penumbra_width);
    }
    imageStore(output_image, pixel, result);
}
