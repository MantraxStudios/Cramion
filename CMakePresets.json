{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "clang-ninja",
      "displayName": "Clang + Ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "clang-ninja-release",
      "inherits": "clang-ninja",
      "displayName": "Clang + Ninja (Release)",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux (Clang + Ninja, Release)",
      "description": "Linux con X11 (o XWayland): el editor, CramionPlayer, CramionServer y la capa de plataforma (ventana Xlib, Vulkan). Necesita libx11-dev, libvulkan-dev, glslc, zenity y curl.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-linux",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ci-windows",
      "inherits": "clang-ninja-release",
      "displayName": "CI Windows (Clang + Ninja, Release)",
      "description": "La de .github/workflows/ci.yml: sin Android, sin escenas de ejemplo, sin el compilador incluido de los scripts ni .pdb (PRUEBAS.md).",
      "binaryDir": "${sourceDir}/build-ci",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CRAMION_ANDROID": "OFF",
        "CRAMION_EXTRACT_SCENES": "OFF",
        "CRAMION_BUNDLE_TOOLCHAIN": "OFF",
        "CRAMION_RELEASE_PDB": "OFF"
      }
    },
    {
      "name": "ci-linux",
      "inherits": "linux-release",
      "displayName": "CI Linux (Clang + Ninja, Release)",
      "description": "La de .github/workflows/ci.yml en Linux: CramionCore, el servidor dedicado y sus pruebas.",
      "binaryDir": "${sourceDir}/build-ci"
    },
    {
      "name": "clang-asan",
      "inherits": "clang-ninja-release",
      "displayName": "Clang + ASan + UBSan (Release)",
      "description": "CRAMION_SANITIZE: las pruebas con AddressSanitizer y UndefinedBehaviorSanitizer (ctest --preset rapidos-asan). Ver PRUEBAS.md.",
      "binaryDir": "${sourceDir}/build-asan",
      "cacheVariables": {
        "CRAMION_ANDROID": "OFF",
        "CRAMION_EXTRACT_SCENES": "OFF",
        "CRAMION_SANITIZE": "ON",
        "CRAMION_RELEASE_PDB": "OFF"
      }
    },
    {
      "name": "clang-fuzz",
      "inherits": "clang-asan",
      "displayName": "Clang + libFuzzer (ASan + UBSan)",
      "description": "CRAMION_FUZZ: objetivos de libFuzzer de los formatos externos (cmake --build --preset clang-fuzz --target cramion_fuzz). Ver PRUEBAS.md.",
      "binaryDir": "${sourceDir}/build-fuzz",
      "cacheVariables": {
        "CRAMION_FUZZ": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "clang-ninja",
      "configurePreset": "clang-ninja"
    },
    {
      "name": "clang-ninja-release",
      "configurePreset": "clang-ninja-release"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "ci-windows",
      "configurePreset": "ci-windows"
    },
    {
      "name": "ci-linux",
      "configurePreset": "ci-linux"
    },
    {
      "name": "clang-asan",
      "configurePreset": "clang-asan",
      "targets": [
        "cramion_tests"
      ]
    },
    {
      "name": "clang-fuzz",
      "configurePreset": "clang-fuzz",
      "targets": [
        "cramion_fuzz"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "rapidos",
      "displayName": "Pruebas rapidas (sin GPU)",
      "configurePreset": "clang-ninja-release",
      "filter": {
        "include": {
          "label": "rapidos"
        },
        "exclude": {
          "label": "gpu"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 4
      }
    },
    {
      "name": "todas-sin-gpu",
      "displayName": "Todas las pruebas sin GPU (rapidas y lentas)",
      "configurePreset": "clang-ninja-release",
      "filter": {
        "exclude": {
          "label": "gpu|fuzz"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 2
      }
    },
    {
      "name": "gpu",
      "displayName": "Pruebas con GPU (a mano, nunca en la CI)",
      "configurePreset": "clang-ninja-release",
      "filter": {
        "include": {
          "label": "gpu"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 1
      }
    },
    {
      "name": "ci-windows",
      "configurePreset": "ci-windows",
      "filter": {
        "include": {
          "label": "rapidos"
        },
        "exclude": {
          "label": "gpu"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 2
      }
    },
    {
      "name": "ci-linux",
      "configurePreset": "ci-linux",
      "filter": {
        "exclude": {
          "label": "gpu|editor"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 2
      }
    },
    {
      "name": "rapidos-asan",
      "displayName": "Pruebas rapidas con ASan + UBSan",
      "configurePreset": "clang-asan",
      "filter": {
        "include": {
          "label": "rapidos"
        },
        "exclude": {
          "label": "gpu"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 2
      }
    },
    {
      "name": "fuzz",
      "displayName": "Fuzzing: 20 s por objetivo (humo)",
      "configurePreset": "clang-fuzz",
      "filter": {
        "include": {
          "label": "fuzz"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 1
      }
    }
  ]
}
